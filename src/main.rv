// dusk: a terminal code editor.
//
//     dusk [files...]
//     dusk --keys "ihello<esc>:w<cr>" --size 100x30 --screen --dump file.rv

from std.env import args, exit
from "github.com/martian56/plumage" import App, Event, Frame, Step, next, quit, run
from "github.com/martian56/plumage/buffer" import Buffer
from "./editor" import Ed, new_editor
from "./view" import render
from "./keys" import parse_script

let VERSION = "0.1.0"

fun update(ed: Ed, e: Event) -> Step[Ed] {
    match e {
        case KeyPress(k) { ed.handle_key(k) }
        case Mouse(m) { ed.handle_mouse(m) }
        case Paste(s) { ed.paste_text(s) }
        case _ {}
    }
    return quit(ed) if ed.quit else next(ed)
}

fun headless(ed: Ed, script: str, w: int, h: int, screen: bool, dump: bool) {
    var frame = Frame(Buffer.new(w, h))
    render(ed, frame)
    for ev in parse_script(script) {
        if ev.is_mouse {
            ed.handle_mouse(ev.mouse)
        } else {
            ed.handle_key(ev.key)
        }
        frame = Frame(Buffer.new(w, h))
        render(ed, frame)
        if ed.quit {
            break
        }
    }
    if screen {
        for y in range(h) {
            print(frame.buf.row_text(y).trim_end())
        }
    }
    if dump {
        print("----- ${ed.doc().path} -----")
        print(ed.doc().text(), end: "")
    }
}

fun main() {
    let a = args()
    let files: list[str] = []
    var script = ""
    var size = "100x30"
    var screen = false
    var dump = false
    var i = 1
    while i < len(a) {
        let x = a[i]
        if x == "--version" or x == "-V" {
            print("dusk ${VERSION}")
            return
        } else if x == "--help" or x == "-h" {
            print("dusk ${VERSION}: a terminal code editor")
            print("")
            print("usage: dusk [files...]")
            print("  --keys SCRIPT   replay keys without a terminal, e.g. \"ihi<esc>:w<cr>\"")
            print("  --size WxH      screen size for --keys (default 100x30)")
            print("  --screen        print the final screen after --keys")
            print("  --dump          print the current buffer after --keys")
            print("")
            print("Inside dusk, press F1 for keys and commands.")
            return
        } else if x == "--keys" and i + 1 < len(a) {
            script = a[i + 1]
            i += 1
        } else if x == "--size" and i + 1 < len(a) {
            size = a[i + 1]
            i += 1
        } else if x == "--screen" {
            screen = true
        } else if x == "--dump" {
            dump = true
        } else {
            files.push(x)
        }
        i += 1
    }
    let ed = new_editor(files)
    if script != "" or screen or dump {
        let parts = size.split("x")
        let w = parts[0].parse_int().unwrap_or(100) if len(parts) == 2 else 100
        let h = parts[1].parse_int().unwrap_or(30) if len(parts) == 2 else 30
        headless(ed, script, w, h, screen, dump)
        return
    }
    let app = App(init: () => ed, update: update, view: render, tick_ms: 500)
    if not run(app) {
        print("dusk needs a terminal; use --keys to drive it from a script")
        exit(1)
    }
}
