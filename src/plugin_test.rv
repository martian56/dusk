from std.test import assert_eq_str, assert_eq_int, assert_true, assert_false
from std.env import get_env
from std.fs import write, remove_file, create_dir_all
from std.process import run
from "./install" import remove_tree
from std.time import now_millis
from std.sync import sleep_millis
from "github.com/martian56/plumage" import Frame
from "github.com/martian56/plumage/buffer" import Buffer
from "./config" import Config, Plugin
from "./editor" import Ed, new_editor_with, edit_error
from "./host" import Edit, Contribution, HostAction, Mark, Block, PanelSpec
from "./keys" import parse_script
from "./view" import render

fun fake_binary() -> str {
    let base = "tests/fake-plugin/target/raven-out/fake-plugin"
    return base + ".exe" if get_env("OS") == "Windows_NT" else base
}

fun fake_plugin(mode: str, activation: list[str]) -> Plugin {
    return Plugin(
        name: "fake",
        command: fake_binary(),
        args: [mode],
        input: "none",
        output: "message",
        key: "",
        on: "",
        description: "",
        protocol: true,
        activation: activation,
    )
}

fun editor(mode: str, paths: list[str]) -> Ed {
    let cfg = Config(plugins: [fake_plugin(mode, ["startup"])])
    return new_editor_with(paths, cfg)
}

fun wait_for(ed: Ed, ms: int, pred: fun(Ed) -> bool) -> bool {
    let end = now_millis() + ms
    while now_millis() < end {
        ed.plugin_tick(now_millis())
        if pred(ed) {
            return true
        }
        sleep_millis(20)
    }
    return false
}

fun ready(ed: Ed) -> bool = wait_for(ed, 5000, e => e.plug.commands.has("fake.hello"))

fun keys(ed: Ed, script: str) {
    for ev in parse_script(script) {
        ed.handle_mouse(ev.mouse) if ev.is_mouse else ed.handle_key(ev.key)
    }
}

fun status_line(ed: Ed) -> str {
    let f = Frame(Buffer.new(120, 10))
    render(ed, f)
    return f.buf.row_text(8)
}

fun test_plugin_command_runs_from_palette() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    assert_true(ed.command_names().any(c => c.starts_with("fake.hello")))
    ed.run("fake.hello", 1)
    assert_true(wait_for(ed, 5000, e => e.message == "hello from fake"))
    ed.shutdown_plugins()
}

fun test_plugin_binding_runs_command() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    keys(ed, "gh")
    assert_true(wait_for(ed, 5000, e => e.message == "hello from fake"))
    ed.shutdown_plugins()
}

fun test_status_item_is_shown() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    ed.run("fake.hello", 1)
    assert_true(wait_for(ed, 5000, e => e.plug.status.has("fake/fake")))
    assert_true(status_line(ed).contains("said hello"))
    ed.shutdown_plugins()
}

fun test_user_binding_wins() {
    let user: dict[str, str] = {}
    user.set("g h", "file_start")
    let table: dict[str, dict[str, str]] = {}
    table.set("normal", user)
    let cfg = Config(plugins: [fake_plugin("echo", ["startup"])], keys: table)
    let ed = new_editor_with([], cfg)
    let _ = ed.doc().insert_at(0, 0, "a\nb\nc")
    ed.doc().row = 2
    assert_true(ready(ed))
    keys(ed, "gh")
    assert_eq_int(ed.doc().row, 0)
    assert_false(wait_for(ed, 300, e => e.message == "hello from fake"))
    ed.shutdown_plugins()
}

fun test_action_plugins_unchanged() {
    let echo = Plugin(
        name: "hi",
        command: "cmd" if get_env("OS") == "Windows_NT" else "sh",
        args: ["/c", "echo hi"] if get_env("OS") == "Windows_NT" else ["-c", "echo hi"],
        input: "none",
        output: "message",
        key: "",
        on: "",
        description: "",
    )
    let ed = new_editor_with([], Config(plugins: [echo]))
    ed.ex("plugin.hi")
    assert_eq_str(ed.message, "hi: hi")
    assert_eq_int(len(ed.plug.hosts), 0)
}

fun test_language_activation_waits_for_a_file() {
    let cfg = Config(plugins: [fake_plugin("echo", ["language:raven"])])
    let ed = new_editor_with([], cfg)
    assert_eq_int(len(ed.plug.hosts), 0)
    write("_dusk_lang_test.rv", "fun main() {}\n")
    ed.open("_dusk_lang_test.rv")
    assert_eq_int(len(ed.plug.hosts), 1)
    assert_true(ready(ed))
    ed.shutdown_plugins()
    let _ = remove_file("_dusk_lang_test.rv")
}

fun with_file(name: str, body: str) -> str {
    write(name, body)
    return name
}

fun chars_status(ed: Ed) -> str = ed.plug.status.get("fake/chars").unwrap_or("")

fun test_opening_a_file_updates_char_status() {
    let f = with_file("_dusk_open_test.txt", "hello\n")
    let ed = editor("echo", [f])
    assert_true(wait_for(ed, 5000, e => chars_status(e) == "chars: 5"))
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_edits_notify_and_recount() {
    let f = with_file("_dusk_edit_test.txt", "hello\n")
    let ed = editor("echo", [f])
    assert_true(wait_for(ed, 5000, e => chars_status(e) == "chars: 5"))
    keys(ed, "Aab<esc>")
    assert_true(wait_for(ed, 5000, e => chars_status(e) == "chars: 7"))
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_plugin_edit_applies_and_undoes() {
    let f = with_file("_dusk_pedit_test.txt", "hello\n")
    let ed = editor("echo", [f])
    assert_true(ready(ed))
    ed.run("fake.edit", 1)
    assert_true(wait_for(ed, 5000, e => e.doc().lines[0] == "Xhello"))
    keys(ed, "u")
    assert_eq_str(ed.doc().lines[0], "hello")
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_stale_edit_is_rejected() {
    let f = with_file("_dusk_stale_test.txt", "hello\n")
    let ed = editor("echo", [f])
    assert_true(ready(ed))
    ed.run("fake.edit", 1)
    let _ = ed.doc().insert_at(0, 5, "!")
    assert_true(wait_for(ed, 5000, e => e.message.contains("stale version")))
    assert_eq_str(ed.doc().lines[0], "hello!")
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_save_and_close_send_events() {
    let a = with_file("_dusk_ev_a.txt", "a\n")
    let b = with_file("_dusk_ev_b.txt", "b\n")
    let ed = editor("record", [a, b])
    assert_true(ready(ed))
    ed.ex("w")
    ed.ex("bdelete")
    assert_true(
        wait_for(
            ed,
            5000,
            e => e.plug.status.get("fake/seen").unwrap_or("").contains("buffer/closed"),
        ),
    )
    let seen = ed.plug.status.get("fake/seen").unwrap_or("")
    assert_true(seen.contains("buffer/opened"))
    assert_true(seen.contains("buffer/saved"))
    ed.shutdown_plugins()
    let _ = remove_file(a)
    let _ = remove_file(b)
}

fun test_plugin_log_opens_a_buffer() {
    let ed = editor("garbage", [])
    assert_true(wait_for(ed, 5000, e => e.message.contains("protocol error")))
    ed.ex("plugin log fake")
    assert_true(ed.doc().text().contains("this is not json"))
    ed.ex("plugin log nobody")
    assert_true(ed.message.contains("no plugin nobody"))
    ed.shutdown_plugins()
}

fun test_plugin_command_runs_from_ex() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    ed.ex("fake.hello")
    assert_true(wait_for(ed, 5000, e => e.message == "hello from fake"))
    ed.shutdown_plugins()
}

fun edit(r1: int, c1: int, r2: int, c2: int, text: str) -> Edit {
    return Edit(start_row: r1, start_col: c1, end_row: r2, end_col: c2, text: text)
}

fun test_overlapping_and_out_of_range_edits_are_refused() {
    let ed = new_editor_with([], Config())
    let _ = ed.doc().insert_at(0, 0, "a\nb\nc")
    let d = ed.doc()
    assert_true(edit_error(d, [edit(0, 0, 2, 0, ""), edit(1, 0, 2, 0, "")]).contains("overlap"))
    assert_true(edit_error(d, [edit(5, 0, 5, 0, "x")]) != "")
    assert_true(edit_error(d, [edit(0, 1, 0, 0, "x")]) != "")
    assert_eq_str(edit_error(d, [edit(2, 0, 2, 1, "z"), edit(0, 0, 0, 1, "y")]), "")
}

fun test_plugin_cannot_take_builtin_or_foreign_names() {
    let ed = new_editor_with([], Config())
    let cs = [
        Contribution(name: "save", title: ""),
        Contribution(name: "other.x", title: ""),
        Contribution(name: "fake.ok", title: ""),
    ]
    ed.apply_action(HostAction.Commands("fake", cs))
    assert_true(ed.plug.commands.has("fake.ok"))
    assert_false(ed.plug.commands.has("save"))
    assert_false(ed.plug.commands.has("other.x"))
}

fun test_startup_and_language_start_once() {
    write("_dusk_once_test.rv", "fun main() {}\n")
    let cfg = Config(plugins: [fake_plugin("echo", ["startup", "language:raven"])])
    let ed = new_editor_with(["_dusk_once_test.rv"], cfg)
    assert_eq_int(len(ed.plug.hosts), 1)
    ed.shutdown_plugins()
    let _ = remove_file("_dusk_once_test.rv")
}

fun test_restart_replays_open_buffers() {
    let f = with_file("_dusk_restart_test.txt", "hi\n")
    let ed = editor("record", [f])
    assert_true(ready(ed))
    ed.run("fake.die", 1)
    assert_true(wait_for(ed, 5000, e => e.plug.hosts[0].state == "exited"))
    let _ = ed.plug.status.remove("fake/seen")
    ed.run("fake.hello", 1)
    assert_true(
        wait_for(
            ed,
            5000,
            e => e.plug.status.get("fake/seen").unwrap_or("").contains("buffer/opened"),
        ),
    )
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_tick_if_due_is_rate_limited() {
    let ed = new_editor_with([], Config())
    assert_true(ed.tick_if_due(1000))
    assert_false(ed.tick_if_due(1020))
    assert_true(ed.tick_if_due(1060))
}

fun screen(ed: Ed, w: int, h: int) -> list[str] {
    let f = Frame(Buffer.new(w, h))
    render(ed, f)
    let out: list[str] = []
    for y in range(h) {
        out.push(f.buf.row_text(y))
    }
    return out
}

fun with_panel() -> Ed {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    ed.run("fake.panel", 1)
    assert_true(wait_for(ed, 5000, e => len(e.plug.panels) == 1))
    let _ = screen(ed, 120, 30)
    return ed
}

fun last_event(ed: Ed, want: str) -> bool = wait_for(ed, 5000, e => e.message.starts_with(want))

fun test_panel_opens_docked_right() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    let _ = screen(ed, 120, 30)
    let wide = ed.text_w
    ed.run("fake.panel", 1)
    assert_true(wait_for(ed, 5000, e => len(e.plug.panels) == 1))
    let rows = screen(ed, 120, 30)
    assert_true(ed.text_w <= wide - 48)
    assert_true(rows[1].chars().slice(72, 120).join("").contains("Fake"))
    assert_true("|".join(rows).contains("two.rv  2 hits"))
    ed.shutdown_plugins()
}

fun test_f6_cycles_focus_and_esc_returns() {
    let ed = with_panel()
    keys(ed, "<f6>")
    assert_eq_str(ed.mode, "panel")
    assert_eq_int(ed.plug.focus, 0)
    keys(ed, "<f6>")
    assert_eq_str(ed.mode, "normal")
    assert_eq_int(ed.plug.focus, 0 - 1)
    keys(ed, "<s-f6><esc>")
    assert_eq_str(ed.mode, "normal")
    assert_eq_int(ed.plug.focus, 0 - 1)
    ed.shutdown_plugins()
}

fun test_choose_in_list_sends_event() {
    let ed = with_panel()
    keys(ed, "<f6><down><cr>")
    assert_true(last_event(ed, "event p1 files choose 1"))
    ed.shutdown_plugins()
}

fun test_input_submit_sends_text() {
    let ed = with_panel()
    keys(ed, "<f6><tab>hi<cr>")
    assert_true(last_event(ed, "event p1 ask submit \"hi\""))
    ed.shutdown_plugins()
}

fun test_click_focuses_panel() {
    let ed = with_panel()
    keys(ed, "<click:100,6>")
    assert_eq_str(ed.mode, "panel")
    keys(ed, "<click:10,6>")
    assert_eq_str(ed.mode, "normal")
    ed.shutdown_plugins()
}

fun test_close_button_sends_closed_event() {
    let ed = with_panel()
    keys(ed, "<click:119,2>")
    assert_eq_int(len(ed.plug.panels), 0)
    assert_true(last_event(ed, "event p1  closed"))
    ed.shutdown_plugins()
}

fun test_replace_keeps_focus() {
    let ed = with_panel()
    keys(ed, "<f6><down>")
    ed.run("fake.panel", 1)
    let _ = wait_for(ed, 500, e => false)
    assert_eq_str(ed.mode, "panel")
    assert_eq_int(ed.plug.panels[0].sel.get("files").unwrap_or(0), 1)
    ed.shutdown_plugins()
}

fun test_status_shows_panel_mode() {
    let ed = with_panel()
    keys(ed, "<f6>")
    assert_true(screen(ed, 120, 30)[28].contains("PANEL"))
    ed.shutdown_plugins()
}

fun test_pick_answers_with_choice() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    ed.run("fake.pick", 1)
    assert_true(wait_for(ed, 5000, e => e.mode == "picker"))
    assert_eq_str("|".join(ed.picker_shown), "a|b  second|c")
    keys(ed, "<down><cr>")
    let _ = last_event(ed, "picked b")
    assert_eq_str(ed.message, "picked b")
    ed.shutdown_plugins()
}

fun test_pick_escape_answers_minus_one() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    ed.run("fake.pick", 1)
    assert_true(wait_for(ed, 5000, e => e.mode == "picker"))
    keys(ed, "<esc>")
    assert_true(last_event(ed, "picked "))
    assert_eq_str(ed.mode, "normal")
    ed.shutdown_plugins()
}

fun test_prompt_answers_text() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    ed.run("fake.prompt", 1)
    assert_true(wait_for(ed, 5000, e => e.mode == "prompt"))
    assert_true(screen(ed, 80, 10)[9].starts_with("Name: x"))
    keys(ed, "yz<cr>")
    assert_true(last_event(ed, "typed xyz"))
    ed.run("fake.prompt", 1)
    assert_true(wait_for(ed, 5000, e => e.mode == "prompt"))
    keys(ed, "<esc>")
    assert_true(last_event(ed, "cancelled"))
    ed.shutdown_plugins()
}

fun test_ask_waits_for_normal_mode() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    keys(ed, "i")
    ed.run("fake.pick", 1)
    let _ = wait_for(ed, 500, e => false)
    assert_eq_str(ed.mode, "insert")
    keys(ed, "<esc>")
    assert_true(wait_for(ed, 5000, e => e.mode == "picker"))
    ed.shutdown_plugins()
}

fun test_marks_draw_in_gutter_and_message() {
    let f = with_file("_dusk_marks_test.txt", "first\nsecond\n")
    let ed = editor("echo", [f])
    assert_true(ready(ed))
    ed.run("fake.marks", 1)
    assert_true(wait_for(ed, 5000, e => e.mark_at(f, 0).is_some()))
    ed.say("")
    let rows = screen(ed, 100, 12)
    assert_eq_str(rows[1].chars()[22], "E")
    assert_true(rows[11].contains("error: bad line"))
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_marks_for_unopened_file_apply_on_open() {
    let f = with_file("_dusk_marks_later.txt", "x\n")
    let ed = editor("echo", [])
    assert_true(ready(ed))
    let none: list[Mark] = []
    ed.apply_action(
        HostAction.Marks("fake", f, [Mark(row: 0, severity: "warning", message: "later", sign: "")]),
    )
    ed.open(f)
    assert_eq_str(ed.mark_at(f, 0).unwrap().message, "later")
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_marks_past_end_are_ignored() {
    let f = with_file("_dusk_marks_far.txt", "only\n")
    let ed = editor("echo", [f])
    assert_true(ready(ed))
    ed.run("fake.marks", 1)
    assert_true(wait_for(ed, 5000, e => e.mark_at(f, 0).is_some()))
    assert_true(ed.mark_at(f, 999).is_none())
    let _ = screen(ed, 100, 12)
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_plugin_exit_clears_its_ui() {
    let f = with_file("_dusk_exit_ui.txt", "x\n")
    let ed = editor("echo", [f])
    assert_true(ready(ed))
    ed.run("fake.panel", 1)
    ed.run("fake.marks", 1)
    ed.run("fake.hello", 1)
    assert_true(
        wait_for(
            ed,
            5000,
            e => len(e.plug.panels) == 1 and e.mark_at(f, 0).is_some() and e.plug.status.has(
                "fake/fake",
            ),
        ),
    )
    keys(ed, "<f6>")
    ed.run("fake.die", 1)
    assert_true(wait_for(ed, 5000, e => e.plug.hosts[0].state == "exited"))
    assert_eq_int(len(ed.plug.panels), 0)
    assert_true(ed.mark_at(f, 0).is_none())
    assert_false(ed.plug.status.has("fake/fake"))
    assert_eq_str(ed.mode, "normal")
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun long_text(n: int) -> str {
    let parts: list[str] = []
    for i in range(n) {
        parts.push("line ${i}")
    }
    return "\n\n".join(parts)
}

fun make_block(id: str, kind: str, text: str) -> Block = Block(id: id, kind: kind, text: text)

fun text_panel(ed: Ed, with_input: bool) {
    let blocks: list[Block] = []
    blocks.push(make_block("t", "text", long_text(200)))
    if with_input {
        blocks.push(make_block("ask", "input", ""))
    }
    ed.apply_action(
        HostAction.Panel("fake", PanelSpec(id: "p", title: "Long", dock: "right", blocks: blocks)),
    )
    let _ = screen(ed, 120, 30)
}

fun test_text_only_panel_scrolls_by_keyboard() {
    let ed = new_editor_with([], Config())
    text_panel(ed, false)
    keys(ed, "<f6><down><down>")
    assert_eq_int(ed.plug.panels[0].scroll, 2)
}

fun test_input_panel_scrolls_text_above() {
    let ed = new_editor_with([], Config())
    text_panel(ed, true)
    keys(ed, "<f6><pagedown>")
    assert_true(ed.plug.panels[0].scroll >= 10)
}

fun test_text_block_renders_once_per_change() {
    let ed = new_editor_with([], Config())
    text_panel(ed, false)
    let before = ed.plug.panels[0].renders
    for i in range(20) {
        let _ = screen(ed, 120, 30)
    }
    assert_eq_int(ed.plug.panels[0].renders, before)
}

fun test_global_keys_work_in_a_focused_panel() {
    let f = with_file("_dusk_panel_save.txt", "a\n")
    let ed = new_editor_with([f], Config())
    keys(ed, "ix<esc>")
    assert_true(ed.doc().dirty)
    text_panel(ed, true)
    keys(ed, "<f6><c-s>")
    assert_false(ed.doc().dirty)
    let _ = remove_file(f)
}

fun test_f6_is_ignored_while_a_pick_is_open() {
    let ed = with_panel()
    ed.run("fake.pick", 1)
    assert_true(wait_for(ed, 5000, e => e.mode == "picker"))
    keys(ed, "<f6>")
    assert_eq_str(ed.mode, "picker")
    keys(ed, "<down><cr>")
    assert_true(last_event(ed, "picked b"))
    ed.shutdown_plugins()
}

fun test_clicking_a_button_presses_it() {
    let ed = with_panel()
    let rows = screen(ed, 120, 30)
    var y = 0 - 1
    var x = 0 - 1
    for i in range(len(rows)) {
        let at = rows[i].index_of("[ Stop ]")
        if at >= 0 and y < 0 {
            y = i
            x = rows[i].substring(0, at).chars().len()
        }
    }
    assert_true(y >= 0)
    keys(ed, "<click:${x + 3},${y + 1}>")
    assert_true(last_event(ed, "event p1 act press 1"))
    ed.shutdown_plugins()
}

fun test_marks_leave_line_numbers_whole() {
    let body: list[str] = []
    for i in range(120) {
        body.push("x")
    }
    let f = with_file("_dusk_marks_wide.txt", "\n".join(body) + "\n")
    let ed = new_editor_with([f], Config())
    ed.apply_action(
        HostAction.Marks("fake", f, [Mark(row: 104, severity: "error", message: "m", sign: "")]),
    )
    ed.doc().row = 104
    ed.doc().top = 100
    let rows = screen(ed, 100, 12)
    assert_true(rows.any(r => r.contains("E105  x")))
    assert_true(rows.any(r => r.contains(" 104  x")))
    let _ = remove_file(f)
}

fun test_files_changed_reloads_a_clean_buffer() {
    let f = with_file("_dusk_touch_clean.txt", "before\n")
    let ed = editor("echo", [f])
    assert_true(ready(ed))
    ed.run("fake.touch", 1)
    assert_true(wait_for(ed, 5000, e => e.doc().lines[0] == "changed on disk"))
    assert_false(ed.doc().dirty)
    keys(ed, "u")
    assert_eq_str(ed.doc().lines[0], "before")
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_files_changed_keeps_unsaved_edits() {
    let f = with_file("_dusk_touch_dirty.txt", "before\n")
    let ed = editor("echo", [f])
    assert_true(ready(ed))
    keys(ed, "Amine<esc>")
    ed.run("fake.touch", 1)
    assert_true(wait_for(ed, 5000, e => e.message.contains("changed on disk")))
    assert_eq_str(ed.doc().lines[0], "beforemine")
    ed.shutdown_plugins()
    let _ = remove_file(f)
}

fun test_plugin_install_and_remove_from_the_editor() {
    let root = "_dusk_ed_install"
    let _ = remove_tree(root)
    let _ = create_dir_all("${root}/src")
    let _ = run("git", ["init", "-q", "${root}/src"])
    let bin = "../../../" + fake_binary()
    write(
        "${root}/src/dusk-plugin.toml",
        "name = \"fake\"\nversion = \"0.1.0\"\ncommand = \"${bin}\"\nargs = [\"echo\"]\n",
    )
    let id = ["-C", "${root}/src", "-c", "user.name=t", "-c", "user.email=t@example.com"]
    let _ = run("git", id.concat(["add", "."]))
    let _ = run("git", id.concat(["commit", "-q", "-m", "first"]))
    let _ = run("git", id.concat(["tag", "v0.1.0"]))
    let ed = new_editor_with([], Config())
    ed.plug.install_root = "${root}/plugins"
    ed.ex("plugin install ./${root}/src@v0.1.0")
    assert_true(wait_for(ed, 20000, e => e.plug.commands.has("fake.hello")))
    assert_true(ed.message.contains("installed fake 0.1.0"))
    ed.ex("plugin list")
    assert_true(ed.message.contains("fake 0.1.0 @v0.1.0"))
    ed.ex("plugin remove fake")
    assert_true(wait_for(ed, 10000, e => e.message.contains("removed fake")))
    assert_false(ed.plug.commands.has("fake.hello"))
    assert_eq_int(len(ed.plug.hosts), 0)
    let _ = remove_tree(root)
}

fun test_files_changed_ignores_identical_text() {
    let f = with_file("_dusk_same.txt", "no newline")
    let ed = new_editor_with([f], Config())
    let undo = len(ed.doc().undo)
    ed.apply_action(HostAction.FilesChanged("rook", [f]))
    assert_eq_int(len(ed.doc().undo), undo)
    assert_false(ed.message.contains("reloaded"))
    keys(ed, "Ax<esc>")
    ed.say("")
    write("_dusk_other.txt", "y\n")
    ed.apply_action(HostAction.FilesChanged("rook", [f]))
    assert_false(ed.message.contains("changed on disk"))
    let _ = remove_file(f)
    let _ = remove_file("_dusk_other.txt")
}

fun test_ask_opens_from_a_focused_panel() {
    let ed = with_panel()
    keys(ed, "<f6>")
    ed.run("fake.pick", 1)
    assert_true(wait_for(ed, 5000, e => e.mode == "picker"))
    keys(ed, "<cr>")
    assert_true(last_event(ed, "picked a"))
    ed.shutdown_plugins()
}

fun test_visual_selection_reaches_a_plugin_command_from_ex() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    let _ = ed.doc().insert_at(0, 0, "alpha\nbeta")
    keys(ed, "Vj:fake.sel<cr>")
    assert_true(wait_for(ed, 5000, e => e.message.starts_with("sel ")))
    assert_true(ed.message.contains("alpha") and ed.message.contains("beta"))
    ed.shutdown_plugins()
}

fun fake_repo(root: str) {
    let _ = remove_tree(root)
    let _ = create_dir_all("${root}/src")
    let _ = run("git", ["init", "-q", "${root}/src"])
    let bin = "../../../" + fake_binary()
    write(
        "${root}/src/dusk-plugin.toml",
        "name = \"fake\"\nversion = \"0.1.0\"\ncommand = \"${bin}\"\nargs = [\"echo\"]\n",
    )
    let id = ["-C", "${root}/src", "-c", "user.name=t", "-c", "user.email=t@example.com"]
    let _ = run("git", id.concat(["add", "."]))
    let _ = run("git", id.concat(["commit", "-q", "-m", "first"]))
    let _ = run("git", id.concat(["tag", "v0.1.0"]))
}

fun test_config_plugin_wins_and_survives_failed_updates() {
    let root = "_dusk_ed_config"
    fake_repo(root)
    let ed = editor("echo", [])
    assert_true(ready(ed))
    ed.plug.install_root = "${root}/plugins"
    ed.ex("plugin update fake@v0.1.0")
    assert_true(ed.message.contains("no installed plugin fake"))
    assert_eq_str(ed.plug.hosts[0].state, "running")
    ed.ex("plugin remove fake")
    assert_true(ed.message.contains("no installed plugin fake"))
    assert_eq_str(ed.plug.hosts[0].state, "running")
    ed.ex("plugin install ./${root}/src@v0.1.0")
    assert_true(wait_for(ed, 20000, e => e.message.contains("runs instead")))
    assert_eq_int(len(ed.plug.hosts), 1)
    assert_eq_str(ed.plug.hosts[0].spec.command, fake_binary())
    ed.ex("plugin update fake@v0.1.0")
    assert_true(wait_for(ed, 20000, e => e.message.contains("runs instead")))
    ed.ex("plugin remove fake")
    assert_true(ed.message.contains("removed fake"))
    assert_eq_str(ed.plug.hosts[0].state, "running")
    ed.shutdown_plugins()
    let _ = remove_tree(root)
}

fun test_external_change_reloads_a_clean_buffer() {
    let f = with_file("_dusk_ext_clean.txt", "one\n")
    let ed = new_editor_with([f], Config())
    sleep_millis(30)
    write(f, "two\n")
    ed.check_disk()
    assert_eq_str(ed.doc().lines[0], "two")
    assert_true(ed.message.contains("reloaded"))
    let _ = remove_file(f)
}

fun test_external_change_to_unsaved_edits_asks() {
    let f = with_file("_dusk_ext_dirty.txt", "one\n")
    let ed = new_editor_with([f], Config())
    keys(ed, "Ax<esc>")
    sleep_millis(30)
    write(f, "two\n")
    ed.check_disk()
    assert_eq_str(ed.mode, "confirm")
    assert_true(ed.message.contains("r reload"))
    keys(ed, "k")
    assert_eq_str(ed.doc().lines[0], "onex")
    ed.check_disk()
    assert_eq_str(ed.mode, "normal")
    sleep_millis(30)
    write(f, "three\n")
    ed.check_disk()
    keys(ed, "r")
    assert_eq_str(ed.doc().lines[0], "three")
    assert_false(ed.doc().dirty)
    let _ = remove_file(f)
}

fun test_disk_question_waits_for_normal_mode() {
    let f = with_file("_dusk_ext_wait.txt", "one\n")
    let ed = new_editor_with([f], Config())
    keys(ed, "Ax")
    sleep_millis(30)
    write(f, "two\n")
    ed.check_disk()
    assert_eq_str(ed.mode, "insert")
    keys(ed, "<esc>")
    ed.check_disk()
    assert_eq_str(ed.mode, "confirm")
    keys(ed, "k")
    let _ = remove_file(f)
}

fun test_duplicate_pick_labels_answer_by_position() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    let h = ed.plug.hosts[0]
    ed.apply_from(Some(h), HostAction.Pick("fake", 77, "Twice", [("same", ""), ("same", "")]))
    ed.update_asks()
    assert_eq_str(ed.mode, "picker")
    keys(ed, "<down>")
    assert_eq_int(ed.picker_index(), 1)
    ed.shutdown_plugins()
}

fun test_close_panel_needs_a_focused_panel() {
    let ed = with_panel()
    ed.run("close_panel", 1)
    assert_eq_int(len(ed.plug.panels), 1)
    assert_true(ed.message.contains("F6"))
    keys(ed, "<f6>")
    ed.run("close_panel", 1)
    assert_eq_int(len(ed.plug.panels), 0)
    ed.shutdown_plugins()
}

fun test_save_as_tells_plugins_about_both_names() {
    let a = with_file("_dusk_saveas_a.txt", "a\n")
    let ed = editor("record", [a])
    assert_true(ready(ed))
    ed.ex("w _dusk_saveas_b.txt")
    assert_true(
        wait_for(
            ed,
            5000,
            e => e.plug.status.get("fake/seen").unwrap_or("").split("buffer/opened").len() == 3,
        ),
    )
    assert_true(ed.plug.status.get("fake/seen").unwrap_or("").contains("buffer/closed"))
    ed.shutdown_plugins()
    let _ = remove_file(a)
    let _ = remove_file("_dusk_saveas_b.txt")
}

fun test_long_status_items_are_cut() {
    let ed = new_editor_with([], Config())
    ed.apply_action(
        HostAction.Status(
            "fake",
            "x",
            "a very long status item that would push the position off screen",
        ),
    )
    let line = status_line(ed)
    assert_true(line.contains("Ln 1"))
    assert_true(line.contains("…"))
}

fun test_clicking_away_from_a_disk_question_asks_again_later() {
    let f = with_file("_dusk_ext_click.txt", "one\n")
    let ed = new_editor_with([f], Config())
    let _ = screen(ed, 100, 12)
    keys(ed, "Ax<esc>")
    sleep_millis(30)
    write(f, "two\n")
    ed.check_disk()
    assert_eq_str(ed.mode, "confirm")
    keys(ed, "<click:50,5>")
    assert_eq_str(ed.mode, "normal")
    ed.check_disk()
    assert_eq_str(ed.mode, "confirm")
    keys(ed, "k")
    let _ = remove_file(f)
}

fun test_reload_while_selecting_lines_does_not_crash() {
    let body: list[str] = []
    for i in range(60) {
        body.push("line ${i}")
    }
    let f = with_file("_dusk_ext_visual.txt", "\n".join(body) + "\n")
    let ed = new_editor_with([f], Config())
    ed.doc().row = 50
    keys(ed, "V10k")
    sleep_millis(30)
    write(f, "short\n")
    ed.check_disk()
    let _ = screen(ed, 100, 12)
    assert_eq_str(ed.doc().lines[0], "short")
    assert_eq_str(ed.mode, "normal")
    let _ = remove_file(f)
}

fun test_plugin_defines_sets_and_lists_themes() {
    let ed = editor("echo", [])
    assert_true(ready(ed))
    ed.ex("fake.theme")
    assert_true(wait_for(ed, 5000, e => e.message.starts_with("themes ")))
    assert_eq_str(ed.theme.name, "fake-neon")
    assert_true(ed.message.contains("current fake-neon"))
    assert_eq_str(ed.theme.g("brand"), " neon ")
    assert_eq_str(ed.theme.label("normal"), "GLOW")
    ed.ex("theme no-such-theme")
    assert_true(ed.message.contains("no theme"))
    assert_eq_str(ed.theme.name, "fake-neon")
    ed.shutdown_plugins()
}

fun test_plugin_baseline_highlights_changes() {
    let path = "target/baseline-test.txt"
    let _ = write(path, "one\nnew\nthree\nfour\n")
    let ed = editor("echo", [path])
    assert_true(ready(ed))
    ed.ex("fake.baseline")
    assert_true(wait_for(ed, 5000, e => len(e.change_kinds(e.doc())) > 0))
    let ks = ed.change_kinds(ed.doc())
    assert_eq_int(ks[0], 0)
    assert_eq_int(ks[1], 2)
    assert_eq_int(ks[3], 1)
    ed.run("next_change", 1)
    assert_eq_int(ed.doc().row, 1)
    ed.run("next_change", 1)
    assert_eq_int(ed.doc().row, 3)
    ed.ex("fake.unbase")
    assert_true(wait_for(ed, 5000, e => len(e.change_kinds(e.doc())) == 0))
    ed.shutdown_plugins()
    let _ = remove_file(path)
}

fun test_reload_highlights_what_changed_on_disk() {
    let path = "target/reload-diff-test.txt"
    let _ = write(path, "keep\nold line\n")
    let ed = editor("echo", [path])
    assert_true(ready(ed))
    ed.ex("fake.touch")
    assert_true(wait_for(ed, 5000, e => e.doc().lines[0] == "changed on disk"))
    let ks = ed.change_kinds(ed.doc())
    assert_true(ks.any(k => k != 0))
    assert_true(ed.message.contains("changed"))
    ed.run("clear_changes", 1)
    assert_eq_int(len(ed.change_kinds(ed.doc())), 0)
    ed.shutdown_plugins()
    let _ = remove_file(path)
}

fun test_revert_change_restores_the_baseline_hunk() {
    let path = "target/revert-test.txt"
    let _ = write(path, "one\nnew\nthree\nfour\n")
    let ed = editor("echo", [path])
    assert_true(ready(ed))
    ed.ex("fake.baseline")
    assert_true(wait_for(ed, 5000, e => len(e.change_kinds(e.doc())) > 0))
    ed.run("next_change", 1)
    ed.run("revert_change", 1)
    assert_eq_str(ed.doc().lines[1], "old")
    assert_eq_int(len(ed.doc().lines), 4)
    ed.run("next_change", 1)
    assert_eq_int(ed.doc().row, 3)
    ed.run("revert_change", 1)
    assert_eq_int(len(ed.doc().lines), 3)
    assert_eq_int(len(ed.change_kinds(ed.doc()).filter(k => k != 0)), 0)
    ed.ex("diff")
    assert_true(ed.message.contains("no line changes"))
    ed.shutdown_plugins()
    let _ = remove_file(path)
}
