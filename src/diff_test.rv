from std.test import assert_eq_str, assert_eq_int
from "./diff" import line_changes, change_counts

fun shown(old: str, new: str) -> str {
    let ks = line_changes(old.split(","), new.split(","))
    return "".join(ks.map(k => "${k}"))
}

fun test_identical_text_has_no_changes() {
    assert_eq_str(shown("a,b,c", "a,b,c"), "000")
}

fun test_added_rows() {
    assert_eq_str(shown("a,c", "a,b,c"), "010")
    assert_eq_str(shown("a", "a,b,c"), "011")
    assert_eq_str(shown("c", "a,b,c"), "110")
}

fun test_changed_rows() {
    assert_eq_str(shown("a,b,c", "a,B,c"), "020")
    assert_eq_str(shown("a,b,c,d", "a,X,Y,Z,d"), "02210")
}

fun test_removed_rows_mark_the_next_row() {
    assert_eq_str(shown("a,b,c", "a,c"), "03")
    assert_eq_str(shown("a,b,c", "a,b"), "03")
    assert_eq_str(shown("a,b,c", "b,c"), "30")
}

fun test_scattered_edits() {
    assert_eq_str(shown("1,2,3,4,5,6", "1,X,3,4,6,7"), "020031")
}

fun test_counts() {
    let (a, c, r) = change_counts(line_changes("a,b,c,d".split(","), "a,X,c,d,e".split(",")))
    assert_eq_int(a, 1)
    assert_eq_int(c, 1)
    assert_eq_int(r, 0)
}
