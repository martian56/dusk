from std.test import assert_eq_str, assert_eq_int, assert_true, assert_false
from "./doc" import open_doc, csub, clen

fun test_insert_and_delete_across_lines() {
    let d = open_doc("", -1)
    let _ = d.insert_at(0, 0, "hello world")
    let (r, c) = d.insert_at(0, 5, ",\nbig\n")
    assert_eq_int(r, 2)
    assert_eq_int(c, 0)
    assert_eq_str("|".join(d.lines), "hello,|big| world")
    assert_eq_str(d.delete_range(0, 3, 2, 2), "lo,\nbig\n w")
    assert_eq_str(d.lines[0], "helorld")
}

fun test_undo_and_redo() {
    let d = open_doc("", -1)
    d.checkpoint()
    let _ = d.insert_at(0, 0, "one")
    d.checkpoint()
    let _ = d.insert_at(0, 3, " two")
    assert_true(d.do_undo())
    assert_eq_str(d.lines[0], "one")
    assert_true(d.do_redo())
    assert_eq_str(d.lines[0], "one two")
    assert_true(d.do_undo())
    assert_true(d.do_undo())
    assert_false(d.do_undo())
}

fun test_chars_not_bytes() {
    assert_eq_int(clen("héllo"), 5)
    assert_eq_str(csub("héllo", 1, 3), "él")
}

fun test_delete_lines_keeps_one() {
    let d = open_doc("", -1)
    let _ = d.insert_at(0, 0, "a\nb")
    assert_eq_str(d.delete_lines(0, 1), "a\nb\n")
    assert_eq_int(len(d.lines), 1)
}
