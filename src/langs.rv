    out.push(scala)

    return out
}

fun lang_for_path(langs: list[Lang], path: str) -> int {
    let slash = max(path.last_index_of("/"), path.last_index_of("\\"))
    let base = path.substring(slash + 1, path.length())
    let dot = base.last_index_of(".")
    let ext = base.substring(dot + 1, base.length()).to_lower() if dot >= 0 else ""
    for i in range(len(langs)) {
        let l = langs[i]
        if base in l.files {
            return i
        }
        if ext != "" and ext in l.exts {
            return i
        }
        if base.to_lower() == l.name {
            return i
        }
    }
    return -1
}

fun lang_named(langs: list[Lang], name: str) -> int {
    for i in range(len(langs)) {
        if langs[i].name == name {
            return i
        }
    }
    return -1
}
