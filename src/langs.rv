// Language definitions for highlighting, comment toggling, and detection.
// Every built-in language is plain data, and a [[language]] table in the
// config builds the same structure, so user languages work identically.

class Lang {
    name: str
    exts: list[str]
    // Exact file names, such as Makefile or Dockerfile.
    files: list[str]
    line_comment: str
    block_start: str
    block_end: str
    quotes: list[str]
    // Delimiters of strings that may span lines, such as """ or ```.
    multi: list[str]
    // word -> token kind (KEYWORD, TYPE, CONSTANT, BUILTIN)
    words: dict[str, int]
    // Words compare lowercased (SQL).
    nocase: bool
    // Extra identifier characters beyond letters, digits, and `_`.
    ident_extra: str
    // A capitalized word is a type (Raven, Rust, Java, ...).
    cap_types: bool
    // `#`-directives (C) or `@`-attributes (Raven, Python, Java).
    directive: str
    // `<tag>` markup (HTML, XML).
    markup: bool
    // A word before this separator at the start of a line is a key.
    key_sep: str
    // Markdown headings, emphasis, and lists.
    markdown: bool
    indent_after: str
}

let NORMAL = 0
let KEYWORD = 1
let TYPE = 2
let CONSTANT = 3
let NUMBER = 4
let STRING = 5
let COMMENT = 6
let FUNCTION = 7
let OPERATOR = 8
let DIRECTIVE = 9
let KEY = 10
let TAG = 11
let HEADING = 12
let BUILTIN = 13
let KIND_NAMES = [
    "normal",
    "keyword",
    "type",
    "constant",
    "number",
    "string",
    "comment",
    "function",
    "operator",
    "directive",
    "key",
    "tag",
    "heading",
    "builtin",
]

fun word_map(
    keywords: list[str],
    types: list[str],
    consts: list[str],
    builtins: list[str],
) -> dict[str, int] {
    let m: dict[str, int] = {}
    for w in builtins {
        m.set(w, BUILTIN)
    }
    for w in consts {
        m.set(w, CONSTANT)
    }
    for w in types {
        m.set(w, TYPE)
    }
    for w in keywords {
        m.set(w, KEYWORD)
    }
    return m
}

fun lang(
    name: str,
    exts: list[str],
    line_comment: str,
    block: list[str],
    keywords: list[str],
    types: list[str],
    consts: list[str],
) -> Lang {
    let none: list[str] = []
    return Lang(
        name: name,
        exts: exts,
        files: none,
        line_comment: line_comment,
        block_start: block[0] if len(block) == 2 else "",
        block_end: block[1] if len(block) == 2 else "",
        quotes: ["\"", "'"],
        multi: none,
        words: word_map(keywords, types, consts, none),
        nocase: false,
        ident_extra: "",
        cap_types: false,
        directive: "",
        markup: false,
        key_sep: "",
        markdown: false,
        indent_after: "{[(",
    )
}

fun plain_lang() -> Lang {
    let none: list[str] = []
    return lang("text", none, "", none, none, none, none)
}

