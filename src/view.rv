// Drawing one frame of the editor. Also records the layout on the editor so
// mouse positions can be mapped back to buffers, files, and tabs.

from std.time import now_millis
from "github.com/martian56/plumage" import Frame
from "github.com/martian56/plumage/buffer" import Buffer
from "github.com/martian56/plumage/style" import Style
from "github.com/martian56/wingspan" import width, truncate
from "./ui" import layout
from "./editor" import Ed, COMMANDS
from "./doc" import Doc, cell_col
from "./langs" import KIND_NAMES
from "./highlight" import highlight_line, kinds_for, quick_end_state

fun put(buf: Buffer, x: int, y: int, s: str, st: Style) -> int {
    if y < 0 or y >= buf.h or x >= buf.w {
        return x
    }
    return buf.set_string(x, y, s, st)
}

fun fill_row(buf: Buffer, x0: int, x1: int, y: int, st: Style) {
    for x in range(max(0, x0), min(x1, buf.w)) {
        buf.set(x, y, " ", st)
    }
}

fun ensure_hl(ed: Ed, d: Doc, upto: int) {
    if d.lang < 0 {
        return
    }
    let l = ed.langs[d.lang]
    let n = len(d.lines)
    if len(d.hl) == 0 {
        d.hl.push(0)
        d.hl_valid = 0
    }
    d.hl_valid = min(d.hl_valid, n - 1)
    while len(d.hl) > d.hl_valid + 1 {
        let _ = d.hl.pop()
    }
    let target = min(upto, n - 1)
    while d.hl_valid < target {
        let r = d.hl_valid
        var next = quick_end_state(l, d.lines[r], d.hl[r])
        if next < 0 {
            next = highlight_line(l, d.lines[r].chars(), d.hl[r]).end_state
        }
        d.hl.push(next)
        d.hl_valid += 1
    }
}

fun mode_label(ed: Ed) -> (str, str) {
    let m = ed.mode
    if m == "insert" {
        return (ed.theme.label("insert"), "ui.mode.insert")
    }
    if m == "visual" {
        return (ed.theme.label("visual"), "ui.mode.visual")
    }
    if m == "vline" {
        return (ed.theme.label("vline"), "ui.mode.visual")
    }
    if m == "prompt" or m == "picker" {
        return (ed.theme.label("command"), "ui.mode.command")
    }
    if m == "tree" {
        return (ed.theme.label("files"), "ui.mode.command")
    }
    if m == "panel" {
        return (ed.theme.label("panel"), "ui.mode.command")
    }
    return (ed.theme.label("normal"), "ui.mode.normal")
}

fun render(ed: Ed, f: Frame) {
    let buf = f.buf
    let t = ed.theme
    let bg = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.bg"))
    let bar = Style.new().fg(t.c("ui.bar.fg")).bg(t.c("ui.bar"))
    ed.w = buf.w
    ed.h = buf.h
    for y in range(buf.h) {
        fill_row(buf, 0, buf.w, y, bg)
    }
    let panel_h = min(12, buf.h / 3) if ed.show_panel and len(ed.panel) > 0 else 0
    let docked = ed.plug.panels
    let has_right = docked.any(p => p.spec.dock == "right") and buf.w >= 60
    let has_bottom = docked.any(
        p => p.spec.dock == "bottom" or (p.spec.dock == "right" and buf.w < 60),
    )
    let right_w = min(60, buf.w * 2 / 5) if has_right else 0
    let bottom_h = min(14, buf.h / 3) if has_bottom else 0
    let body_h = max(1, buf.h - 3 - panel_h - bottom_h)
    let side_w = min(34, max(22, buf.w / 5)) if ed.show_tree and buf.w >= 60 else 0
    let d = ed.doc()
    let digits = "${len(d.lines)}".length()
    var gutter = 0 if ed.cfg.numbers == "off" else max(3, digits) + 2
    // A column for plugin marks, so a sign never covers a line number.
    // A column for plugin marks and change bars, so neither covers a line
    // number.
    if ed.has_marks(d.path) or ed.plug.bases.has(d.path) {
        gutter += 2 if gutter == 0 else 1
    }
    ed.side_w = side_w
    ed.text_x = side_w
    ed.text_y = 1
    ed.text_h = body_h
    ed.gutter_w = gutter
    ed.text_w = max(1, buf.w - side_w - gutter - right_w)
    ed.scroll_into_view()

    draw_tabs(ed, buf, bar)
    if side_w > 0 {
        draw_tree(ed, buf, side_w, body_h)
    }
    draw_text(ed, buf, d, side_w, gutter, body_h)
    if panel_h > 0 {
        draw_panel(ed, buf, 1 + body_h, panel_h)
    }
    draw_docked(ed, buf, right_w, body_h, 1 + body_h + panel_h, bottom_h)
    draw_status(ed, buf, buf.h - 2)
    draw_message(ed, buf, buf.h - 1)
    if ed.mode == "picker" {
        draw_picker(ed, buf)
    } else if ed.mode == "help" {
        draw_help(ed, buf, body_h)
    } else if ed.mode == "prompt" and ed.prompt_kind == "command" and ed.prompt != "" {
        draw_completions(ed, buf)
    }
}

fun tab_label(ed: Ed, i: int) -> str {
    let dd = ed.docs[i]
    var name = dd.path.substring(dd.path.last_index_of("/") + 1, dd.path.length()) if dd.path != "" else "[new]"
    if dd.dirty {
        name += " " + ed.theme.g("tab.dirty")
    }
    return " ${name} "
}

// The first tab to draw so the active one fits in `room` cells: tabs scroll
// as little as possible, keeping as many on the left as fit.
fun first_tab(ed: Ed, room: int) -> int {
    let widths = range(len(ed.docs)).map(
        i => width(tab_label(ed, i)) + 1 + (2 if i == ed.cur else 0),
    )
    var first = 0
    var used = 0
    for i in range(ed.cur + 1) {
        used += widths[i]
    }
    while first < ed.cur and used > room {
        used -= widths[first]
        first += 1
    }
    return first
}

fun draw_tabs(ed: Ed, buf: Buffer, bar: Style) {
    let t = ed.theme
    fill_row(buf, 0, buf.w, 0, bar)
    let hits: list[(int, int, int)] = []
    var x = 0
    let brand = Style.new().fg(t.c("ui.mode.normal")).bg(t.c("ui.bar")).bold()
    x = put(buf, x, 0, t.g("brand"), brand)
    let more = Style.new().fg(t.c("ui.mode.command")).bg(t.c("ui.bar")).bold()
    let first = first_tab(ed, buf.w - x - 2)
    if first > 0 {
        x = put(buf, x, 0, "‹", more)
    }
    for i in range(first, len(ed.docs)) {
        let active = i == ed.cur
        let st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.tab.active")).bold() if active else Style.new().fg(t.c("ui.gutter")).bg(t.c("ui.bar"))
        let x0 = x
        x = put(buf, x, 0, tab_label(ed, i), st)
        if active {
            let cx = x
            x = put(
                buf,
                x,
                0,
                t.g("tab.close") + " ",
                Style.new().fg(t.c("ui.gutter")).bg(t.c("ui.tab.active")),
            )
            hits.push((x0, cx, i))
            hits.push((cx, x, -1))
        } else {
            hits.push((x0, x, i))
        }
        x = put(buf, x, 0, t.g("tab.sep"), Style.new().fg(t.c("ui.border")).bg(t.c("ui.bar")))
        if x >= buf.w - 1 {
            if i + 1 < len(ed.docs) {
                buf.set(buf.w - 1, 0, "›", more)
            }
            break
        }
    }
    ed.tab_hits = hits
}

fun draw_tree(ed: Ed, buf: Buffer, w: int, h: int) {
    let t = ed.theme
    let base = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.sidebar"))
    for y in range(1, 1 + h) {
        fill_row(buf, 0, w - 1, y, base)
        buf.set(w - 1, y, t.g("border.v"), Style.new().fg(t.c("ui.border")).bg(t.c("ui.bg")))
    }
    if ed.tree_sel < ed.tree_top {
        ed.tree_top = ed.tree_sel
    }
    if ed.mode == "tree" and ed.tree_sel >= ed.tree_top + h {
        ed.tree_top = ed.tree_sel - h + 1
    }
    let current = ed.doc().path
    for i in range(h) {
        let k = ed.tree_top + i
        if k >= len(ed.tree) {
            break
        }
        let it = ed.tree[k]
        let y = 1 + i
        var st = base
        if ed.mode == "tree" and k == ed.tree_sel {
            st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.popup.selected")).bold()
        } else if it.path == current {
            st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.cursorline")).bold()
        }
        fill_row(buf, 0, w - 1, y, st)
        let icon = ((t.g("tree.open") if it.open else t.g("tree.closed")) + " ") if it.dir else "  "
        let fg = Style.new().fg(t.c("ui.dir") if it.dir else t.c("ui.fg")).bg(st.bg)
        let full = " " + "  " * it.depth + icon + it.name
        // A name that does not fit ends in an ellipsis, so it reads as cut.
        let text = full if width(full) <= w - 2 else truncate(full, w - 3) + "…"
        let _ = put(buf, 0, y, text, fg if not (ed.mode == "tree" and k == ed.tree_sel) else st)
    }
}

fun in_sel(ed: Ed, r: int, c: int) -> bool {
    if ed.mode != "visual" and ed.mode != "vline" {
        return false
    }
    let (r1, c1, r2, c2) = ed.sel_range()
    if r < r1 or r > r2 {
        return false
    }
    if ed.mode == "vline" {
        return true
    }
    if r == r1 and c < c1 {
        return false
    }
    if r == r2 and c >= c2 {
        return false
    }
    return true
}

fun search_marks(ed: Ed, line: str) -> list[bool] {
    let cs = line.chars()
    let marks: list[bool] = [false] * len(cs)
    var pat = ed.search
    if ed.mode == "prompt" and ed.prompt_kind == "search" {
        pat = ed.prompt
    }
    if pat == "" {
        return marks
    }
    let nocase = pat == pat.to_lower()
    let pc = (pat.to_lower() if nocase else pat).chars()
    let lc = (line.to_lower() if nocase else line).chars()
    var i = 0
    while i + len(pc) <= len(lc) {
        var ok = true
        var j = 0
        while ok and j < len(pc) {
            if lc[i + j] != pc[j] {
                ok = false
            }
            j += 1
        }
        if ok {
            for k in range(i, i + len(pc)) {
                marks[k] = true
            }
            i += len(pc)
        } else {
            i += 1
        }
    }
    return marks
}

fun draw_text(ed: Ed, buf: Buffer, d: Doc, x0: int, gutter: int, h: int) {
    let t = ed.theme
    let tw = ed.cfg.tab_width
    let kind_bits = KIND_NAMES.map(k => ed.theme.style(k))
    let text_left = x0 + gutter
    // The text ends where a right-docked panel starts.
    let cols = ed.text_w
    let cur_cells = cell_col(d.lines[d.row], d.col, tw)
    if cur_cells < d.left {
        d.left = cur_cells
    } else if cur_cells >= d.left + cols {
        d.left = cur_cells - cols + 1
    }
    ensure_hl(ed, d, d.top + h)
    var bracket_r = -1
    var bracket_c = -1
    match ed.match_bracket_pos() {
        case Some((r, c)) {
            if r != d.row or c != d.col {
                bracket_r = r
                bracket_c = c
            }
        }
        case None {}
    }
    let show_cursor = ed.mode == "normal" or ed.mode == "insert" or ed.mode == "visual" or ed.mode == "vline"
    let changes = ed.change_kinds(d)
    for i in range(h) {
        let y = 1 + i
        let r = d.top + i
        if r >= len(d.lines) {
            let _ = put(buf, x0, y, " ~", Style.new().fg(t.c("ui.gutter")).bg(t.c("ui.bg")))
            continue
        }
        let is_cur = r == d.row
        let change = changes[r] if r < len(changes) else 0
        var row_bg = t.c("ui.cursorline") if is_cur and ed.mode != "visual" and ed.mode != "vline" else t.c("ui.bg")
        if change == 1 and not is_cur {
            row_bg = t.c("ui.diff.add.bg")
        } else if change == 2 and not is_cur {
            row_bg = t.c("ui.diff.change.bg")
        }
        fill_row(buf, x0, buf.w, y, Style.new().bg(row_bg))
        if gutter > 0 {
            var num = r + 1
            if ed.cfg.numbers == "relative" and not is_cur {
                num = r - d.row if r > d.row else d.row - r
            }
            let label = "${num}"
            let gst = Style.new().fg(t.c("ui.gutter.current") if is_cur else t.c("ui.gutter")).bg(row_bg)
            if ed.cfg.numbers != "off" {
                let _ = put(buf, x0 + gutter - 2 - label.length(), y, label, gst)
            }
            if change == 1 or change == 2 {
                buf.set(
                    x0,
                    y,
                    "▎",
                    Style.new().fg(t.c("ui.diff.add") if change == 1 else t.c("ui.diff.change")).bg(row_bg),
                )
            } else if change == 3 {
                buf.set(x0, y, "▔", Style.new().fg(t.c("ui.diff.delete")).bg(row_bg))
            }
            match ed.mark_at(d.path, r) {
                case Some(m) {
                    let sign = m.sign.chars()[0] if m.sign != "" else m.severity.chars()[0].to_upper()
                    buf.set(x0, y, sign, Style.new().fg(t.c(mark_color(m.severity))).bg(row_bg).bold())
                }
                case None {}
            }
        }
        let line = d.lines[r]
        let cs = line.chars()
        var kinds: list[int] = [0] * len(cs)
        if d.lang >= 0 {
            let sp = highlight_line(ed.langs[d.lang], cs, d.hl[r])
            kinds = kinds_for(sp, len(cs))
        }
        let marks = search_marks(ed, line)
        var cell = 0
        var leading = true
        for c in range(len(cs) + 1) {
            let at_end = c == len(cs)
            let ch = " " if at_end else cs[c]
            if not at_end and ch != " " and ch != "\t" {
                leading = false
            }
            var wcells = 1
            if ch == "\t" {
                wcells = tw - cell % tw
            } else if ch.length() > 1 {
                wcells = max(1, width(ch))
            }
            let sx = cell - d.left
            cell += wcells
            if sx + wcells <= 0 {
                continue
            }
            if sx >= cols {
                break
            }
            var fg = t.c(KIND_NAMES[kinds[c]]) if not at_end else t.c("ui.fg")
            var cbg = row_bg
            var bold = false
            if not at_end and marks[c] {
                cbg = t.c("ui.search")
            }
            if in_sel(ed, r, c) and not (at_end and ed.mode == "visual") {
                cbg = t.c("ui.selection")
            }
            if r == bracket_r and c == bracket_c {
                cbg = t.c("ui.match")
                bold = true
            }
            let is_cursor = show_cursor and r == d.row and c == d.col
            if is_cursor {
                cbg = t.c("ui.mode.insert") if ed.mode == "insert" else t.c("ui.cursor")
                fg = t.c("ui.bg")
            }
            var st = Style.new().fg(fg).bg(cbg)
            let bits = 0 if at_end else kind_bits[kinds[c]]
            if bold or bits & 1 != 0 {
                st = st.bold()
            }
            if bits & 2 != 0 {
                st = st.italic()
            }
            if bits & 4 != 0 {
                st = st.underline()
            }
            if bits & 8 != 0 {
                st = st.dim()
            }
            var glyph = ch
            if ch == "\t" {
                glyph = " "
            } else if leading and ch == " " and cell > tw and (cell - 1) % tw == 0 and not is_cursor {
                glyph = t.g("indent")
                st = Style.new().fg(t.c("ui.border")).bg(cbg)
            }
            if at_end and not is_cursor and cbg == row_bg {
                continue
            }
            let px = text_left + max(0, sx)
            if ch == "\t" {
                for k in range(wcells) {
                    if px + k < buf.w and sx + k >= 0 {
                        buf.set(text_left + sx + k, y, " ", st)
                    }
                }
            } else if px < buf.w {
                buf.set(px, y, glyph, st)
            }
        }
    }
}

// The screen cell where character `col` of `line` starts.
// Plugin panels: right-docked ones stacked beside the text, bottom ones side
// by side under it. Records each panel's rectangle for the mouse.
fun draw_docked(ed: Ed, buf: Buffer, right_w: int, body_h: int, bottom_y: int, bottom_h: int) {
    ed.plug.frame += 1
    let n = len(ed.plug.panels)
    let rects: list[(int, int, int, int)] = []
    let right: list[int] = []
    let bottom: list[int] = []
    for i in range(n) {
        rects.push((0, 0, 0, 0))
        right.push(i) if ed.plug.panels[i].spec.dock == "right" and right_w > 0 else bottom.push(i)
    }
    var y = 1
    for k in range(len(right)) {
        let h = body_h / len(right) + (body_h % len(right) if k == len(right) - 1 else 0)
        rects[right[k]] = (buf.w - right_w, y, right_w, h)
        y += h
    }
    var x = 0
    for k in range(len(bottom)) {
        let w = buf.w / len(bottom) + (buf.w % len(bottom) if k == len(bottom) - 1 else 0)
        rects[bottom[k]] = (x, bottom_y, w, bottom_h)
        x += w
    }
    ed.plug.rects = rects
    for i in range(n) {
        let (rx, ry, rw, rh) = rects[i]
        if rw > 2 and rh > 1 {
            draw_plugin_panel(ed, buf, i, rx, ry, rw, rh)
        }
    }
}

fun draw_plugin_panel(ed: Ed, buf: Buffer, i: int, x: int, y: int, w: int, h: int) {
    let t = ed.theme
    let p = ed.plug.panels[i]
    let focused = ed.plug.focus == i
    let bg = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.bg"))
    for yy in range(y, y + h) {
        fill_row(buf, x, x + w, yy, bg)
    }
    let title_bg = t.c("ui.mode.normal") if focused else t.c("ui.bar")
    let title = Style.new().fg(t.c("ui.bg") if focused else t.c("ui.bar.fg")).bg(title_bg).bold()
    fill_row(buf, x, x + w, y, title)
    let _ = put(buf, x, y, truncate(" ${p.spec.title}", w - 3), title)
    let _ = put(buf, x + w - 2, y, "×", title)
    let border = Style.new().fg(t.c("ui.mode.normal") if focused else t.c("ui.border")).bg(
        t.c("ui.bg"),
    )
    for yy in range(y + 1, y + h) {
        buf.set(x, yy, t.g("border.v"), border)
    }
    let cw = w - 2
    let rows = layout(p, cw, h - 1, now_millis() / 100)
    for r in range(len(rows)) {
        let row = rows[r]
        let ry = y + 1 + r
        let cx = x + 2
        if row.kind == "text" and len(row.spans) > 0 {
            var at = cx
            for sp in row.spans {
                at = put(buf, at, ry, sp.text, sp.style.bg(t.c("ui.bg")))
                if at >= x + w {
                    break
                }
            }
            continue
        }
        var st = bg
        if row.kind == "item_sel" {
            st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.tab.active") if focused else t.c("ui.bar")).bold()
            fill_row(buf, cx, x + w, ry, st)
        } else if row.kind == "button" {
            st = Style.new().fg(t.c("ui.mode.normal")).bg(t.c("ui.bg")).bold()
        } else if row.kind == "progress" {
            st = Style.new().fg(t.c("ui.mode.command")).bg(t.c("ui.bg"))
        } else if row.kind == "input" {
            st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.bar"))
            fill_row(buf, cx, x + w, ry, st)
        }
        let _ = put(buf, cx, ry, row.text, st)
        if focused and row.cursor >= 0 and cx + row.cursor < x + w {
            let cs = row.text.chars()
            let under = cs[row.cursor] if row.cursor < len(cs) else " "
            buf.set(cx + row.cursor, ry, under, Style.new().fg(t.c("ui.bg")).bg(t.c("ui.cursor")))
        }
    }
}

// `s` cut to its last `n` characters behind an ellipsis, for paths whose
// file name matters more than their directory.
fun tail_fit(s: str, n: int) -> str {
    let cs = s.chars()
    if len(cs) <= n {
        return s
    }
    if n <= 1 {
        return "…" if n == 1 else ""
    }
    return "…" + "".join(cs.slice(len(cs) - (n - 1), len(cs)))
}

fun draw_status(ed: Ed, buf: Buffer, y: int) {
    let t = ed.theme
    let d = ed.doc()
    let bar = Style.new().fg(t.c("ui.bar.fg")).bg(t.c("ui.bar"))
    fill_row(buf, 0, buf.w, y, bar)
    let (label, color) = mode_label(ed)
    let lname = ed.langs[d.lang].name if d.lang >= 0 else "text"
    let pct = 100 * (d.row + 1) / len(d.lines)
    var items = ""
    for k in ed.plug.status.keys().sorted() {
        let cs = ed.plug.status.get(k).unwrap().chars()
        let item = "".join(cs.slice(0, 23)) + "…" if len(cs) > 24 else "".join(cs)
        items += "${item}  "
    }
    let where = "${lname}  ${"CRLF" if d.crlf else "LF"}  Ln ${d.row + 1}/${len(d.lines)}, Col ${d.col + 1}  ${pct}% "
    let counted = "${ed.count}" if ed.count > 0 else ""
    let keys = "${counted}${ed.op} ${ed.pending}".trim()
    let left_fixed = len(label.chars()) + 2 + (2 if d.dirty else 0) + (len(keys.chars()) + 2 if keys != "" else 0) + 2
    // The cursor position always shows; plugin items go first when the
    // path would get too short, then the path shrinks from the front.
    var right = items + where
    if buf.w - left_fixed - len(right.chars()) < 12 {
        right = where
    }
    if buf.w - left_fixed - len(right.chars()) < 12 {
        right = "${d.row + 1}:${d.col + 1} "
    }
    let room = max(0, buf.w - left_fixed - len(right.chars()))
    var x = put(buf, 0, y, " ${label} ", Style.new().fg(t.c("ui.bg")).bg(t.c(color)).bold())
    let name = d.path if d.path != "" else "[new]"
    x = put(buf, x, y, " " + tail_fit(name, max(0, room - 1)), bar.bold())
    if d.dirty {
        x = put(
            buf,
            x,
            y,
            " " + t.g("status.dirty"),
            Style.new().fg(t.c("ui.mode.command")).bg(t.c("ui.bar")),
        )
    }
    if keys != "" {
        x = put(buf, x + 2, y, keys, Style.new().fg(t.c("ui.mode.command")).bg(t.c("ui.bar")))
    }
    let _ = put(buf, max(x + 1, buf.w - right.chars().len()), y, right, bar)
}

fun draw_message(ed: Ed, buf: Buffer, y: int) {
    let t = ed.theme
    let st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.bg"))
    if ed.mode == "prompt" {
        let k = ed.prompt_kind
        var lead = ":"
        if k == "search" {
            lead = "?" if ed.search_back else "/"
        } else if k == "goto" {
            lead = "Go to line: "
        } else if k == "grep" {
            lead = "Search the project: "
        } else if k == "rename" {
            lead = "Rename to: "
        } else if k == "save_as" {
            lead = "Save as: "
        } else if k == "plugin" {
            lead = "${ed.ask_title()}: "
        }
        var x = put(buf, 0, y, lead + ed.prompt, st)
        buf.set(min(x, buf.w - 1), y, " ", Style.new().bg(t.c("ui.cursor")))
        return
    }
    if ed.message != "" {
        let mst = Style.new().fg(t.c("ui.error")).bg(t.c("ui.bg")).bold() if ed.error else st
        let _ = put(buf, 0, y, truncate(ed.message, buf.w - 1), mst)
        return
    }
    if ed.mode == "normal" {
        let d = ed.doc()
        match ed.mark_at(d.path, d.row) {
            case Some(m) {
                let mst = Style.new().fg(t.c(mark_color(m.severity))).bg(t.c("ui.bg"))
                let _ = put(buf, 0, y, truncate("${m.severity}: ${m.message}", buf.w - 1), mst)
            }
            case None {}
        }
    }
}

fun mark_color(severity: str) -> str {
    if severity == "error" {
        return "ui.error"
    }
    return "ui.mode.command" if severity == "warning" else "ui.gutter"
}

fun draw_box(ed: Ed, buf: Buffer, x: int, y: int, w: int, h: int, title: str) {
    let t = ed.theme
    let st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.popup"))
    let border = Style.new().fg(t.c("ui.border")).bg(t.c("ui.popup"))
    for yy in range(y, y + h) {
        fill_row(buf, x, x + w, yy, st)
    }
    for xx in range(x, x + w) {
        buf.set(xx, y, t.g("border.h"), border)
        buf.set(xx, y + h - 1, t.g("border.h"), border)
    }
    for yy in range(y, y + h) {
        buf.set(x, yy, t.g("border.v"), border)
        buf.set(x + w - 1, yy, t.g("border.v"), border)
    }
    buf.set(x, y, t.g("corner.tl"), border)
    buf.set(x + w - 1, y, t.g("corner.tr"), border)
    buf.set(x, y + h - 1, t.g("corner.bl"), border)
    buf.set(x + w - 1, y + h - 1, t.g("corner.br"), border)
    let _ = put(
        buf,
        x + 2,
        y,
        " ${title} ",
        Style.new().fg(t.c("ui.mode.normal")).bg(t.c("ui.popup")).bold(),
    )
}

fun draw_picker(ed: Ed, buf: Buffer) {
    let t = ed.theme
    let w = min(buf.w - 4, 90)
    let h = min(buf.h - 4, 22)
    let x = (buf.w - w) / 2
    let y = 2
    ed.box_x = x
    ed.box_y = y
    ed.box_w = w
    ed.box_h = h
    let titles = {
        "files": "Open file",
        "commands": "Commands",
        "buffers": "Open files",
        "themes": "Theme",
        "languages": "Language",
        "grep": "Matches",
    }
    let title = ed.ask_title() if ed.picker_kind == "plugin" else titles.get(ed.picker_kind).unwrap_or("Pick")
    draw_box(ed, buf, x, y, w, h, "${title}  ${len(ed.picker_shown)}/${len(ed.picker_items)}")
    let st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.popup"))
    var cx = put(buf, x + 2, y + 1, "› " + ed.prompt, st.bold())
    buf.set(min(cx, x + w - 2), y + 1, " ", Style.new().bg(t.c("ui.cursor")))
    let rows = h - 3
    if ed.picker_sel < ed.picker_top {
        ed.picker_top = ed.picker_sel
    }
    if ed.picker_sel >= ed.picker_top + rows {
        ed.picker_top = ed.picker_sel - rows + 1
    }
    for i in range(rows) {
        let k = ed.picker_top + i
        if k >= len(ed.picker_shown) {
            break
        }
        let item = ed.picker_shown[k]
        let sel = k == ed.picker_sel
        let rst = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.popup.selected")).bold() if sel else st
        fill_row(buf, x + 1, x + w - 1, y + 2 + i, rst)
        let two = item.index_of("  ")
        if two > 0 {
            let head = item.substring(0, two)
            let tail = item.substring(two, item.length())
            let hx = put(buf, x + 2, y + 2 + i, truncate(head, w - 4), rst)
            let _ = put(
                buf,
                hx,
                y + 2 + i,
                truncate(tail, max(0, x + w - 2 - hx)),
                Style.new().fg(t.c("comment")).bg(rst.bg),
            )
        } else {
            let _ = put(buf, x + 2, y + 2 + i, truncate(item, w - 4), rst)
        }
    }
}

fun draw_completions(ed: Ed, buf: Buffer) {
    let t = ed.theme
    let opts = ed.complete(ed.prompt)
    let n = min(len(opts), 8)
    if n == 0 {
        return
    }
    let st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.popup"))
    for i in range(n) {
        let y = buf.h - 2 - n + i
        fill_row(
            buf,
            0,
            40,
            y,
            st if i > 0 else Style.new().fg(t.c("ui.fg")).bg(t.c("ui.popup.selected")),
        )
        let _ = put(
            buf,
            1,
            y,
            opts[i],
            st if i > 0 else Style.new().fg(t.c("ui.fg")).bg(t.c("ui.popup.selected")).bold(),
        )
    }
}

fun draw_panel(ed: Ed, buf: Buffer, y0: int, h: int) {
    let t = ed.theme
    let head = Style.new().fg(t.c("ui.bar.fg")).bg(t.c("ui.bar")).bold()
    fill_row(buf, 0, buf.w, y0, head)
    let _ = put(buf, 1, y0, "${ed.panel_title}  (Ctrl+L hides)", head)
    let st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.sidebar"))
    let start = max(0, len(ed.panel) - (h - 1))
    for i in range(h - 1) {
        fill_row(buf, 0, buf.w, y0 + 1 + i, st)
        let k = start + i
        if k < len(ed.panel) {
            let _ = put(buf, 1, y0 + 1 + i, truncate(ed.panel[k], buf.w - 2), st)
        }
    }
}

fun describe(name: str) -> str {
    for (n, d) in COMMANDS {
        if n == name {
            return d
        }
    }
    return name.replace("_", " ")
}

fun help_lines(ed: Ed) -> list[str] {
    let out: list[str] = [
        "dusk: a modal editor that also works like a normal one",
        "",
        "Everyday keys work in every mode: Ctrl+S save, Ctrl+Q quit, Ctrl+Z undo, Ctrl+Y redo,",
        "Ctrl+P open a file, Ctrl+F search, Ctrl+K command palette, Ctrl+B file tree, F1 this help.",
        "Press i to type, Esc to go back to normal mode, : for commands (:w, :q, :%s/a/b/g, :theme).",
        "",
        "MOUSE",
        "  click            place the cursor (or open a file / switch tabs)",
        "  drag             select text; drag in the line numbers to select lines",
        "  double-click     select a word",
        "  wheel            scroll the file, the file tree, or a list",
        "  shift+wheel      scroll long lines sideways (a sideways wheel too)",
        "  middle-click     paste",
        "",
        "OPERATORS (normal mode)",
        "  d c y gc + motion   delete, change, copy, comment: dw, ciw, yi(, c$, d3j, gcap",
        "  dd cc yy gcc        the whole line; a count repeats (3dd)",
        "  f t F T + char      to or till a character (dt;)",
        "  i/a + w ( [ { < \" ' `  inside or around a word, brackets, or quotes",
        "",
    ]
    for mode in ["global", "normal", "insert", "visual"] {
        out.push(mode.to_upper() + " KEYS" + (" (every mode)" if mode == "global" else ""))
        match ed.keys.get(mode) {
            case Some(tbl) {
                for (k, v) in tbl {
                    out.push("  ${k}${" " * max(1, 18 - k.length())}${describe(v)}")
                }
            }
            case None {}
        }
        out.push("")
    }
    out.push("COMMAND LINE")
    for line in [
        ":w [name]  save      :q  close or quit   :wq  save and quit   :q!  quit without saving",
        ":e path  open a file   :bn :bp :bd  buffers   :ls  open files   :42  go to line 42",
        ":s/old/new/g  replace in the line   :%s/old/new/g  everywhere   :'<,'>s  in the selection",
        ":sort   :theme [name]   :lang [name]   :set nu|rnu|nonu|ts=2|expandtab|noautopairs",
        ":grep text  search the whole project   :config  edit the config   :plugins  run a plugin   :!cmd  run a shell command",
        ":diff  outside changes as a diff   :clear_changes  drop their highlights   (] c / [ c jump, g r reverts one)",
    ] {
        out.push("  " + line)
    }
    out.push("")
    out.push("THEMES")
    out.push("  :theme previews each theme as you move; Enter keeps it, Esc goes back. Theme files in")
    out.push("  ~/.config/dusk/themes set colors, bold and italic, glyphs, and mode names. For twenty more:")
    out.push("  :plugin install github.com/martian56/dusk-theme")
    out.push("")
    out.push("PLUGINS AND CONFIG")
    out.push("  F12 or :config opens ~/.config/dusk/config.toml with every option documented.")
    out.push("  Bind keys per mode, add languages, override colors, and add [[plugin]] commands")
    out.push("  that send the buffer, selection, or line to any program and use what it prints.")
    out.push("")
    out.push("LANGUAGES")
    var names = ""
    for l in ed.langs {
        names += l.name + " "
    }
    out.push("  " + names)
    return out
}

// Where a wrapped continuation of `cs` should start: under the description of
// a "  key    description" row (after the first run of two or more spaces that
// follows text), otherwise under the line's own indentation.
fun hang_of(cs: list[str]) -> int {
    var i = 0
    while i < len(cs) and cs[i] == " " {
        i += 1
    }
    let lead = i
    var seen_text = false
    while i < len(cs) {
        if cs[i] != " " {
            seen_text = true
            i += 1
            continue
        }
        if seen_text and i + 1 < len(cs) and cs[i + 1] == " " {
            var j = i
            while j < len(cs) and cs[j] == " " {
                j += 1
            }
            return j if j < len(cs) else lead
        }
        i += 1
    }
    return lead
}

// Break `line` into rows of at most `width` cells at spaces, continuing each
// row with a hanging indent. A word longer than a row is split.
fun wrap_line(line: str, width: int) -> list[str] {
    let out: list[str] = []
    let cs = line.chars()
    if width <= 0 or len(cs) <= width {
        out.push(line)
        return out
    }
    var hang = hang_of(cs)
    if hang > width / 2 {
        hang = min(4, width / 4)
    }
    let pad = " " * hang
    var start = 0
    var first = true
    while start < len(cs) {
        let room = width if first else width - hang
        if len(cs) - start <= room {
            out.push((pad if not first else "") + "".join(cs.slice(start, len(cs))))
            break
        }
        var cut = start + room
        var k = cut
        while k > start and cs[k] != " " {
            k -= 1
        }
        if k > start {
            cut = k
        }
        out.push((pad if not first else "") + "".join(cs.slice(start, cut)).trim_end())
        start = cut
        while start < len(cs) and cs[start] == " " {
            start += 1
        }
        first = false
    }
    return out
}

fun draw_help(ed: Ed, buf: Buffer, h: int) {
    let t = ed.theme
    let w = min(buf.w - 2, 100)
    let x = (buf.w - w) / 2
    draw_box(ed, buf, x, 1, w, h, "Help  (j/k or wheel to scroll, Esc to close)")
    let lines: list[str] = []
    let heads: list[bool] = []
    let raw = help_lines(ed)
    for k in range(len(raw)) {
        let line = raw[k]
        let is_head = k == 0 or (line != "" and not line.starts_with(" ") and line == line.to_upper())
        for row in wrap_line(line, w - 4) {
            lines.push(row)
            heads.push(is_head)
        }
    }
    ed.help_top = min(ed.help_top, max(0, len(lines) - (h - 2)))
    let st = Style.new().fg(t.c("ui.fg")).bg(t.c("ui.popup"))
    let head = Style.new().fg(t.c("ui.mode.normal")).bg(t.c("ui.popup")).bold()
    for i in range(h - 2) {
        let k = ed.help_top + i
        if k >= len(lines) {
            break
        }
        let _ = put(buf, x + 2, 2 + i, truncate(lines[k], w - 4), head if heads[k] else st)
    }
}
