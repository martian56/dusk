    }
    return Theme(
        "dusk",
        palette(
            [
                ("ui.bg", "#1e2127"),
                ("ui.fg", "#abb2bf"),
                ("ui.gutter", "#4b5263"),
                ("ui.gutter.current", "#e5c07b"),
                ("ui.cursorline", "#262a31"),
                ("ui.selection", "#3e4451"),
                ("ui.search", "#5c4b1f"),
                ("ui.cursor", "#61afef"),
                ("ui.bar", "#2c313a"),
                ("ui.bar.fg", "#abb2bf"),
                ("ui.tab.active", "#1e2127"),
                ("ui.sidebar", "#1a1d22"),
                ("ui.dir", "#61afef"),
                ("ui.popup", "#2c313a"),
                ("ui.popup.selected", "#3e4451"),
                ("ui.match", "#4b5263"),
                ("ui.error", "#e06c75"),
                ("ui.mode.normal", "#61afef"),
                ("ui.mode.insert", "#98c379"),
                ("ui.mode.visual", "#c678dd"),
                ("ui.mode.command", "#e5c07b"),
                ("ui.border", "#3e4451"),
                ("keyword", "#c678dd"),
                ("type", "#e5c07b"),
                ("constant", "#d19a66"),
                ("number", "#d19a66"),
                ("string", "#98c379"),
                ("comment", "#5c6370"),
                ("function", "#61afef"),
                ("operator", "#56b6c2"),
                ("directive", "#e06c75"),
                ("key", "#e06c75"),
                ("tag", "#e06c75"),
                ("heading", "#61afef"),
                ("builtin", "#56b6c2"),
                ("normal", "#abb2bf"),
            ],
        ),
    )
}

impl Theme {
    // A glyph by name (see GLYPHS).
    fun g(self, name: str) -> str = self.glyphs.get(name).unwrap_or(default_of(GLYPHS, name, "?"))

    // The status bar name of a mode (see LABELS).
    fun label(self, mode: str) -> str = self.labels.get(mode).unwrap_or(
        default_of(LABELS, mode, mode.to_upper()),
    )

    // The style bits of a syntax kind: keywords bold and comments italic unless
    // the theme says otherwise.
    fun style(self, kind: str) -> int {
        match self.styles.get(kind) {
            case Some(b) {
                return b
            }
            case None {}
        }
        if kind == "keyword" {
            return BOLD
        }
        return ITALIC if kind == "comment" else 0
    }

    fun c(self, name: str) -> Color {
        return self.colors.get(name).unwrap_or(Color.Default)
    }

    fun set(self, name: str, value: str) -> bool {
        return match hex(value) {
            case Some(c) {
                self.colors.set(name, c)
                true
            }
            case None { false }
        }
    }
}
