// Colors by name. Syntax kinds use their kind names ("keyword", "string",
// ...); the interface uses "ui.*" names. A config can override any of them
// with "#rrggbb".
//
// Besides the built-in themes, theme files and plugins add their own. A theme
// file is TOML:
//
//     name = "synthwave"
//     description = "Neon over a purple night"
//     base = "dusk"                 # optional; colors not listed come from it
//
//     [colors]
//     "ui.bg" = "#241b2f"
//     keyword = "#fede5d"

from std.fs import read, list_dir, is_dir
from "github.com/martian56/plumage/style" import Color
from "github.com/martian56/raven-toml" import parse

class Theme {
    name: str
    colors: dict[str, Color]
}

// A theme added by a file or a plugin: its own colors over `base`.
class ExtraTheme {
    name: str
    base: str
    description: str
    colors: list[(str, str)]
}

let BUILTIN = ["dusk", "dawn", "gruvbox", "nord"]
let EXTRAS: list[ExtraTheme] = []

fun hex(s: str) -> Option[Color] {
    let h = s.trim().replace("#", "")
    if h.length() != 6 {
        return None
    }
    let digits = "0123456789abcdef"
    var vals: list[int] = []
    let low = h.to_lower()
    for i in range(6) {
        let d = digits.index_of(low.char_at(i))
        if d < 0 {
            return None
        }
        vals.push(d)
    }
    return Some(Color.Rgb(vals[0] * 16 + vals[1], vals[2] * 16 + vals[3], vals[4] * 16 + vals[5]))
}

fun palette(pairs: list[(str, str)]) -> dict[str, Color] {
    let m: dict[str, Color] = {}
    for (k, v) in pairs {
        match hex(v) {
            case Some(c) { m.set(k, c) }
            case None {}
        }
    }
    return m
}

fun theme_names() -> list[str] {
    let out: list[str] = []
    for n in BUILTIN {
        out.push(n)
    }
    for t in EXTRAS {
        out.push(t.name)
    }
    return out
}

fun has_theme(name: str) -> bool = theme_names().contains(name)

// The description of an added theme, empty for a built-in one.
fun theme_description(name: str) -> str {
    for t in EXTRAS {
        if t.name == name {
            return t.description
        }
    }
    return ""
}

// Add or replace a theme. Returns an error message, empty on success.
fun define_theme(name: str, base: str, description: str, colors: list[(str, str)]) -> str {
    let n = name.trim()
    if n == "" {
        return "a theme needs a name"
    }
    if BUILTIN.contains(n) {
        return "${n} is a built-in theme"
    }
    for (k, v) in colors {
        match hex(v) {
            case Some(c) {}
            case None {
                return "theme ${n}: ${k} is not a #rrggbb color"
            }
        }
    }
    let t = ExtraTheme(
        name: n,
        base: base if BUILTIN.contains(base) else "dusk",
        description: description,
        colors: colors,
    )
    for i in range(len(EXTRAS)) {
        if EXTRAS[i].name == n {
            EXTRAS[i] = t
            return ""
        }
    }
    EXTRAS.push(t)
    return ""
}

// Load one theme file. Returns an error message, empty on success.
fun load_theme_file(path: str) -> str {
    let text = match read(path) {
        case Ok(t) { t }
        case Err(e) {
            return "${path}: ${e.message()}"
        }
    }
    let t = match parse(text) {
        case Ok(x) { x }
        case Err(e) {
            return "${path}: ${e.to_string()}"
        }
    }
    let colors: list[(str, str)] = []
    for k in t.keys_under("colors") {
        colors.push((k, t.get_string_or("colors.${k}", "")))
    }
    let err = define_theme(
        t.get_string_or("name", ""),
        t.get_string_or("base", "dusk"),
        t.get_string_or("description", ""),
        colors,
    )
    return "${path}: ${err}" if err != "" else ""
}

// Load every *.toml theme in `dir`, in name order. Returns the errors.
fun load_theme_dir(dir: str) -> list[str] {
    let errs: list[str] = []
    if not is_dir(dir) {
        return errs
    }
    let names = match list_dir(dir) {
        case Ok(xs) { xs }
        case Err(e) {
            return errs
        }
    }
    for n in names.sorted() {
        if n.ends_with(".toml") {
            let err = load_theme_file("${dir}/${n}")
            if err != "" {
                errs.push(err)
            }
        }
    }
    return errs
}

fun make_theme(name: str) -> Theme {
    for t in EXTRAS {
        if t.name == name {
            let base = builtin_theme(t.base)
            base.name = t.name
            for (k, v) in t.colors {
                let _ = base.set(k, v)
            }
            return base
        }
    }
    return builtin_theme(name)
}

