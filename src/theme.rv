            ),
        )
    }
    if name == "nord" {
        return Theme(
            name,
            palette(
                [
                    ("ui.bg", "#2e3440"),
                    ("ui.fg", "#d8dee9"),
                    ("ui.gutter", "#4c566a"),
                    ("ui.gutter.current", "#d8dee9"),
                    ("ui.cursorline", "#3b4252"),
                    ("ui.selection", "#434c5e"),
                    ("ui.search", "#5e81ac"),
                    ("ui.cursor", "#88c0d0"),
                    ("ui.bar", "#3b4252"),
                    ("ui.bar.fg", "#e5e9f0"),
                    ("ui.tab.active", "#2e3440"),
                    ("ui.sidebar", "#272c36"),
                    ("ui.dir", "#81a1c1"),
                    ("ui.popup", "#3b4252"),
