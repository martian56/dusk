// Colors by name. Syntax kinds use their kind names ("keyword", "string",
// ...); the interface uses "ui.*" names. A config can override any of them
// with "#rrggbb".
//
// Besides the built-in themes, theme files and plugins add their own. A theme
// file is TOML:
//
//     name = "synthwave"
//     description = "Neon over a purple night"
//     base = "dusk"                 # optional; colors not listed come from it
//
//     [colors]
//     "ui.bg" = "#241b2f"
//     keyword = "#fede5d"
//
//     [styles]                      # syntax kinds: bold, italic, underline, dim
//     keyword = "bold"
//     comment = "italic dim"
//
//     [glyphs]                      # one cell each, except brand
//     brand = " ~dusk~ "
//     "tree.open" = "-"
//
//     [labels]                      # mode names in the status bar
//     normal = "CHILL"

from std.fs import read, list_dir, is_dir
from "github.com/martian56/plumage/style" import Color
from "github.com/martian56/raven-toml" import parse, Toml

class Theme {
    name: str
    colors: dict[str, Color]
    glyphs: dict[str, str] = {}
    labels: dict[str, str] = {}
    styles: dict[str, int] = {}
}

// A theme added by a file or a plugin: its own colors, styles, glyphs and
// labels over `base`.
class ExtraTheme {
    name: str
    base: str
    description: str
    colors: list[(str, str)]
    styles: list[(str, str)] = []
    glyphs: list[(str, str)] = []
    labels: list[(str, str)] = []
}

// An empty extra theme over dusk, to fill in field by field.
fun extra_theme(name: str) -> ExtraTheme = ExtraTheme(
    name: name,
    base: "dusk",
    description: "",
    colors: [],
)

// Style bits for syntax kinds.
let BOLD = 1
let ITALIC = 2
let UNDERLINE = 4
let DIM = 8

// The glyphs a theme may replace, with dusk's own.
let GLYPHS = [
    ("brand", " dusk "),
    ("tab.dirty", "●"),
    ("tab.close", "×"),
    ("tab.sep", "│"),
    ("tree.open", "▾"),
    ("tree.closed", "▸"),
    ("indent", "┊"),
    ("border.v", "│"),
    ("border.h", "─"),
    ("corner.tl", "╭"),
    ("corner.tr", "╮"),
    ("corner.bl", "╰"),
    ("corner.br", "╯"),
    ("status.dirty", "●"),
]

// The status bar's mode names a theme may replace.
let LABELS = [
    ("normal", "NORMAL"),
    ("insert", "INSERT"),
    ("visual", "VISUAL"),
    ("vline", "V-LINE"),
    ("command", "COMMAND"),
    ("files", "FILES"),
    ("panel", "PANEL"),
]

// The bits for a style such as "bold italic", or -1 for an unknown word.
fun style_bits(s: str) -> int {
    var bits = 0
    for w in s.split(" ") {
        let x = w.trim().to_lower()
        if x == "bold" {
            bits = bits | BOLD
        } else if x == "italic" {
            bits = bits | ITALIC
        } else if x == "underline" {
            bits = bits | UNDERLINE
        } else if x == "dim" {
            bits = bits | DIM
        } else if x != "" and x != "none" and x != "plain" {
            return 0 - 1
        }
    }
    return bits
}

fun known(table: list[(str, str)], key: str) -> bool {
    for (k, v) in table {
        if k == key {
            return true
        }
    }
    return false
}

// Why a theme's styles, glyphs or labels are invalid, empty when they are fine.
fun check_extras(n: str, t: ExtraTheme) -> str {
    for (k, v) in t.styles {
        if style_bits(v) < 0 {
            return "theme ${n}: style ${k} must be bold, italic, underline, dim, or none"
        }
    }
    for (k, v) in t.glyphs {
        if not known(GLYPHS, k) {
            return "theme ${n}: no glyph named ${k}"
        }
        let limit = 16 if k == "brand" else 1
        let n_chars = len(v.chars())
        if n_chars == 0 or n_chars > limit {
            return "theme ${n}: glyph ${k} must be 1 to ${limit} characters"
        }
    }
    for (k, v) in t.labels {
        if not known(LABELS, k) {
            return "theme ${n}: no mode named ${k}"
        }
        let n_chars = len(v.chars())
        if n_chars == 0 or n_chars > 12 {
            return "theme ${n}: label ${k} must be 1 to 12 characters"
        }
    }
    return ""
}

// The default of `key` in `table`, or `fallback`.
fun default_of(table: list[(str, str)], key: str, fallback: str) -> str {
    for (k, v) in table {
        if k == key {
            return v
        }
    }
    return fallback
}

let BUILTIN = ["dusk", "dawn", "gruvbox", "nord"]
let EXTRAS: list[ExtraTheme] = []

fun hex(s: str) -> Option[Color] {
    let h = s.trim().replace("#", "")
    if h.length() != 6 {
        return None
    }
    let digits = "0123456789abcdef"
    var vals: list[int] = []
    let low = h.to_lower()
    for i in range(6) {
        let d = digits.index_of(low.char_at(i))
        if d < 0 {
            return None
        }
        vals.push(d)
    }
    return Some(Color.Rgb(vals[0] * 16 + vals[1], vals[2] * 16 + vals[3], vals[4] * 16 + vals[5]))
}

fun palette(pairs: list[(str, str)]) -> dict[str, Color] {
    let m: dict[str, Color] = {}
    for (k, v) in pairs {
        match hex(v) {
            case Some(c) { m.set(k, c) }
            case None {}
        }
    }
    return m
}

fun theme_names() -> list[str] {
    let out: list[str] = []
    for n in BUILTIN {
        out.push(n)
    }
    for t in EXTRAS {
        out.push(t.name)
    }
    return out
}

fun has_theme(name: str) -> bool = theme_names().contains(name)

// The description of an added theme, empty for a built-in one.
fun theme_description(name: str) -> str {
    for t in EXTRAS {
        if t.name == name {
            return t.description
        }
    }
    return ""
}

// Add or replace a theme. Returns an error message, empty on success.
fun define_theme(name: str, base: str, description: str, colors: list[(str, str)]) -> str {
    return add_theme(ExtraTheme(name: name, base: base, description: description, colors: colors))
}

fun add_theme(spec: ExtraTheme) -> str {
    let base = spec.base
    let description = spec.description
    let colors = spec.colors
    let n = spec.name.trim()
    if n == "" {
        return "a theme needs a name"
    }
    if BUILTIN.contains(n) {
        return "${n} is a built-in theme"
    }
    for (k, v) in colors {
        match hex(v) {
            case Some(c) {}
            case None {
                return "theme ${n}: ${k} is not a #rrggbb color"
            }
        }
    }
    let extras = check_extras(n, spec)
    if extras != "" {
        return extras
    }
    let t = ExtraTheme(
        name: n,
        base: base if BUILTIN.contains(base) else "dusk",
        description: description,
        colors: colors,
        styles: spec.styles,
        glyphs: spec.glyphs,
        labels: spec.labels,
    )
    for i in range(len(EXTRAS)) {
        if EXTRAS[i].name == n {
            EXTRAS[i] = t
            return ""
        }
    }
    EXTRAS.push(t)
    return ""
}

// Load one theme file. Returns an error message, empty on success.
fun load_theme_file(path: str) -> str {
    let text = match read(path) {
        case Ok(t) { t }
        case Err(e) {
            return "${path}: ${e.message()}"
        }
    }
    let t = match parse(text) {
        case Ok(x) { x }
        case Err(e) {
            return "${path}: ${e.to_string()}"
        }
    }
    let err = add_theme(
        ExtraTheme(
            name: t.get_string_or("name", ""),
            base: t.get_string_or("base", "dusk"),
            description: t.get_string_or("description", ""),
            colors: section(t, "colors"),
            styles: section(t, "styles"),
            glyphs: section(t, "glyphs"),
            labels: section(t, "labels"),
        ),
    )
    return "${path}: ${err}" if err != "" else ""
}

// The string entries of a theme file's table, as (key, value).
fun section(t: Toml, name: str) -> list[(str, str)] {
    let out: list[(str, str)] = []
    for k in t.keys_under(name) {
        out.push((k, t.get_string_or("${name}.${k}", "")))
    }
    return out
}

// Load every *.toml theme in `dir`, in name order. Returns the errors.
fun load_theme_dir(dir: str) -> list[str] {
    let errs: list[str] = []
    if not is_dir(dir) {
        return errs
    }
    let names = match list_dir(dir) {
        case Ok(xs) { xs }
        case Err(e) {
            return errs
        }
    }
    for n in names.sorted() {
        if n.ends_with(".toml") {
            let err = load_theme_file("${dir}/${n}")
            if err != "" {
                errs.push(err)
            }
        }
    }
    return errs
}

fun make_theme(name: str) -> Theme {
    for t in EXTRAS {
        if t.name == name {
            let base = builtin_theme(t.base)
            base.name = t.name
            for (k, v) in t.colors {
                let _ = base.set(k, v)
            }
            for (k, v) in t.styles {
                base.styles.set(k, style_bits(v))
            }
            for (k, v) in t.glyphs {
                base.glyphs.set(k, v)
            }
            for (k, v) in t.labels {
                base.labels.set(k, v)
            }
            return base
        }
    }
    return builtin_theme(name)
}

