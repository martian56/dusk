                    ("ui.mode.command", "#fabd2f"),
                    ("ui.border", "#504945"),
                    ("keyword", "#fb4934"),
                    ("type", "#fabd2f"),
                    ("constant", "#d3869b"),
                    ("number", "#d3869b"),
                    ("string", "#b8bb26"),
                    ("comment", "#928374"),
                    ("function", "#8ec07c"),
                    ("operator", "#fe8019"),
                    ("directive", "#8ec07c"),
                    ("key", "#83a598"),
                    ("tag", "#fb4934"),
                    ("heading", "#fabd2f"),
                    ("builtin", "#fe8019"),
                    ("normal", "#ebdbb2"),
