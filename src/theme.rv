                    ("ui.cursor", "#526fff"),
                    ("ui.bar", "#e5e5e6"),
                    ("ui.bar.fg", "#383a42"),
                    ("ui.tab.active", "#fafafa"),
                    ("ui.sidebar", "#f0f0f1"),
                    ("ui.dir", "#4078f2"),
                    ("ui.popup", "#e5e5e6"),
                    ("ui.popup.selected", "#c8d7f9"),
                    ("ui.match", "#c4e2c4"),
                    ("ui.error", "#e45649"),
                    ("ui.mode.normal", "#4078f2"),
                    ("ui.mode.insert", "#50a14f"),
                    ("ui.mode.visual", "#a626a4"),
                    ("ui.mode.command", "#c18401"),
                    ("ui.border", "#c8c8c9"),
                    ("keyword", "#a626a4"),
                    ("type", "#c18401"),
                    ("constant", "#986801"),
                    ("number", "#986801"),
                    ("string", "#50a14f"),
                    ("comment", "#a0a1a7"),
                    ("function", "#4078f2"),
                    ("operator", "#0184bc"),
                    ("directive", "#e45649"),
                    ("key", "#e45649"),
                    ("tag", "#e45649"),
                    ("heading", "#4078f2"),
                    ("builtin", "#0184bc"),
                    ("normal", "#383a42"),
                ],
            ),
        )
    }
    if name == "gruvbox" {
        return Theme(
            name,
            palette(
                [
                    ("ui.bg", "#282828"),
                    ("ui.fg", "#ebdbb2"),
                    ("ui.gutter", "#7c6f64"),
                    ("ui.gutter.current", "#fabd2f"),
                    ("ui.cursorline", "#32302f"),
                    ("ui.selection", "#504945"),
                    ("ui.search", "#79740e"),
                    ("ui.cursor", "#fe8019"),
                    ("ui.bar", "#3c3836"),
                    ("ui.bar.fg", "#ebdbb2"),
                    ("ui.tab.active", "#282828"),
                    ("ui.sidebar", "#1d2021"),
                    ("ui.dir", "#83a598"),
                    ("ui.popup", "#3c3836"),
                    ("ui.popup.selected", "#665c54"),
                    ("ui.match", "#665c54"),
                    ("ui.error", "#fb4934"),
                    ("ui.mode.normal", "#83a598"),
                    ("ui.mode.insert", "#b8bb26"),
                    ("ui.mode.visual", "#d3869b"),
                    ("ui.mode.command", "#fabd2f"),
                    ("ui.border", "#504945"),
                    ("keyword", "#fb4934"),
                    ("type", "#fabd2f"),
                    ("constant", "#d3869b"),
                    ("number", "#d3869b"),
                    ("string", "#b8bb26"),
                    ("comment", "#928374"),
                    ("function", "#8ec07c"),
                    ("operator", "#fe8019"),
                    ("directive", "#8ec07c"),
                    ("key", "#83a598"),
                    ("tag", "#fb4934"),
                    ("heading", "#fabd2f"),
                    ("builtin", "#fe8019"),
                    ("normal", "#ebdbb2"),
                ],
            ),
        )
    }
    if name == "nord" {
        return Theme(
            name,
            palette(
                [
                    ("ui.bg", "#2e3440"),
                    ("ui.fg", "#d8dee9"),
                    ("ui.gutter", "#4c566a"),
                    ("ui.gutter.current", "#d8dee9"),
                    ("ui.cursorline", "#3b4252"),
                    ("ui.selection", "#434c5e"),
                    ("ui.search", "#5e81ac"),
                    ("ui.cursor", "#88c0d0"),
                    ("ui.bar", "#3b4252"),
                    ("ui.bar.fg", "#e5e9f0"),
                    ("ui.tab.active", "#2e3440"),
                    ("ui.sidebar", "#272c36"),
                    ("ui.dir", "#81a1c1"),
                    ("ui.popup", "#3b4252"),
                    ("ui.popup.selected", "#4c566a"),
                    ("ui.match", "#4c566a"),
                    ("ui.error", "#bf616a"),
                    ("ui.mode.normal", "#81a1c1"),
                    ("ui.mode.insert", "#a3be8c"),
                    ("ui.mode.visual", "#b48ead"),
                    ("ui.mode.command", "#ebcb8b"),
                    ("ui.border", "#4c566a"),
                    ("keyword", "#81a1c1"),
                    ("type", "#8fbcbb"),
                    ("constant", "#b48ead"),
                    ("number", "#b48ead"),
                    ("string", "#a3be8c"),
                    ("comment", "#616e88"),
                    ("function", "#88c0d0"),
                    ("operator", "#81a1c1"),
                    ("directive", "#d08770"),
                    ("key", "#8fbcbb"),
                    ("tag", "#81a1c1"),
                    ("heading", "#88c0d0"),
                    ("builtin", "#88c0d0"),
                    ("normal", "#d8dee9"),
                ],
