from std.test import assert_eq_str, assert_eq_int, assert_true, assert_false
from "./editor" import Ed, new_editor
from "./keys" import parse_script
from "github.com/martian56/perch/keys" import Key

fun run_keys(text: str, keys: str) -> Ed {
    let ed = new_editor([])
    let _ = ed.doc().insert_at(0, 0, text)
    ed.doc().dirty = false
    for ev in parse_script(keys) {
        ed.handle_mouse(ev.mouse) if ev.is_mouse else ed.handle_key(ev.key)
    }
    return ed
}

fun text(ed: Ed) -> str = "|".join(ed.doc().lines)

fun test_insert_and_escape() {
    assert_eq_str(text(run_keys("", "ihello<esc>")), "hello")
    assert_eq_str(text(run_keys("a", "ohi<esc>Oup<esc>")), "a|up|hi")
}

fun test_operators_and_counts() {
    assert_eq_str(text(run_keys("one two three", "dw")), "two three")
    assert_eq_str(text(run_keys("a\nb\nc\nd", "2dd")), "c|d")
    assert_eq_str(text(run_keys("f(a, b)", "f(ldt,")), "f(, b)")
    assert_eq_str(text(run_keys("f(a, b)", "fbci(x<esc>")), "f(x)")
    assert_eq_str(text(run_keys("x = 1", "yyp")), "x = 1|x = 1")
}

fun test_undo_groups_an_insert_session() {
    assert_eq_str(text(run_keys("start", "A one<cr>two<esc>u")), "start")
}

fun test_dot_repeats_last_change() {
    assert_eq_str(text(run_keys("a\nb\nc", "dd.")), "c")
}

fun test_visual_and_comment() {
    assert_eq_str(text(run_keys("a\nb\nc", "Vjd")), "c")
    assert_eq_str(text(run_keys("x\ny", "gcc")), "x|y")
}

fun test_replace_command() {
    assert_eq_str(text(run_keys("a-b\nc-d", ":%s/-/+/g<cr>")), "a+b|c+d")
}

fun test_shift_selection_types_over() {
    assert_eq_str(text(run_keys("hello world", "i<s-right><s-right><s-right>J<esc>")), "Jlo world")
}

fun test_insert_mapping_waits_then_types() {
    let ed = new_editor([])
    ed.keys.get("insert").unwrap().set("j k", "normal_mode")
    for ev in parse_script("ijar jk") {
        ed.handle_key(ev.key)
    }
    assert_eq_str(ed.doc().lines[0], "jar ")
    assert_eq_str(ed.mode, "normal")
}

fun test_leader_key_waits_for_the_next_key() {
    assert_true(run_keys("abc", "<space>q").quit)
    assert_false(run_keys("abc", "<space>").quit)
}

fun test_sideways_wheel_scrolls_long_lines() {
    let long = "x" + " word" * 60
    let ed = run_keys("short\n" + long + "\nend", "j")
    for i in range(5) {
        ed.handle_mouse(parse_script("<wheelright:10,3>")[0].mouse)
    }
    let d = ed.doc()
    assert_eq_int(d.left, 30)
    assert_true(d.col >= 30)
    ed.handle_mouse(parse_script("<wheelleft:10,3>")[0].mouse)
    assert_eq_int(d.left, 24)
    for i in range(20) {
        ed.handle_mouse(parse_script("<wheelleft:10,3>")[0].mouse)
    }
    assert_eq_int(d.left, 0)
    for i in range(200) {
        ed.handle_mouse(parse_script("<wheelright:10,3>")[0].mouse)
    }
    assert_eq_int(d.left, long.length() - ed.text_w + 1)
}

fun test_dd_on_an_empty_buffer_stays_clean() {
    let ed = run_keys("", "dd")
    assert_false(ed.doc().dirty)
}

fun test_undo_back_to_the_saved_text_is_clean() {
    let ed = run_keys("abc", "")
    ed.doc().path = "target/undo-clean.txt"
    ed.doc().disk = "abc"
    for ev in parse_script("xu") {
        ed.handle_key(ev.key)
    }
    assert_eq_str(text(ed), "abc")
    assert_false(ed.doc().dirty)
    for ev in parse_script("<c-r>") {
        ed.handle_key(ev.key)
    }
    assert_true(ed.doc().dirty)
}

fun test_click_lands_after_wide_characters() {
    let ed = run_keys("日本語abc", "")
    ed.text_x = 0
    ed.gutter_w = 0
    // Each of the three wide characters takes two cells, so cell 6 is "a".
    let (r, c) = ed.cell_to_pos(6, 1)
    assert_eq_int(c, 3)
    let (r2, c2) = ed.cell_to_pos(3, 1)
    assert_eq_int(c2, 1)
}

fun test_theme_picker_previews_and_restores() {
    let ed = run_keys("x", "")
    ed.run("pick_theme", 1)
    assert_eq_str(ed.theme.name, "dusk")
    let second = ed.picker_shown[1]
    for ev in parse_script("<down>") {
        ed.handle_key(ev.key)
    }
    assert_eq_str(ed.theme.name, second)
    for ev in parse_script("<esc>") {
        ed.handle_key(ev.key)
    }
    assert_eq_str(ed.theme.name, "dusk")
    ed.run("pick_theme", 1)
    let third = ed.picker_shown[2]
    for ev in parse_script("<down><down><cr>") {
        ed.handle_key(ev.key)
    }
    assert_eq_str(ed.theme.name, third)
    assert_eq_str(ed.mode, "normal")
}

fun test_alt_letters_bind_or_act_as_escape_and_key() {
    // Bound: Alt+J moves the line down.
    let ed = run_keys("a\nb", "")
    ed.handle_key(Key.Mod("alt+j"))
    assert_eq_str(text(ed), "b|a")
    // Unbound in insert mode: Esc, then the key in normal mode (x deletes).
    let ed2 = run_keys("abc", "i")
    ed2.handle_key(Key.Mod("alt+x"))
    assert_eq_str(ed2.mode, "normal")
    assert_eq_str(text(ed2), "bc")
}
