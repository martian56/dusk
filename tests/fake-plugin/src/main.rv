// A scripted protocol plugin for dusk's host tests.
//
//     fake-plugin echo|record|crash|flood|silent|garbage|deaf|bigline
//
// record behaves as echo and also lists every notification it received in
// the status item "seen".

from std.env import args, exit
from std.sync import sleep_millis
from std.fs import write
from std.io import read_line, print
from std.json import JsonValue, parse, stringify, json_int, json_string, json_object, json_array

fun obj(pairs: list[(str, JsonValue)]) -> JsonValue {
    let m: dict[str, JsonValue] = {}
    for (k, v) in pairs {
        m.set(k, v)
    }
    return json_object(m)
}

fun s(x: str) -> JsonValue = json_string(x)

fun send(pairs: list[(str, JsonValue)]) {
    let all: list[(str, JsonValue)] = [("jsonrpc", s("2.0"))]
    for p in pairs {
        all.push(p)
    }
    print(stringify(obj(all)) + "\n")
}

fun notify(method: str, params: JsonValue) {
    send([("method", s(method)), ("params", params)])
}

fun reply(id: int, result: JsonValue) {
    send([("id", json_int(id)), ("result", result)])
}

fun str_of(v: JsonValue, key: str) -> str {
    return match v.get(key) {
        case Some(x) { x.as_string().unwrap_or("") }
        case None { "" }
    }
}

fun int_of(v: JsonValue, key: str) -> int {
    return match v.get(key) {
        case Some(x) { x.as_int().unwrap_or(0 - 1) }
        case None { 0 - 1 }
    }
}

fun block(pairs: list[(str, JsonValue)]) -> JsonValue = obj(pairs)

fun panel(dock: str) -> JsonValue {
    let rows = json_array(
        [s("one.rv"), obj([("label", s("two.rv")), ("detail", s("2 hits"))]), s("three.rv")],
    )
    let blocks = json_array(
        [
            block(
                [
                    ("id", s("intro")),
                    ("kind", s("text")),
                    ("text", s("# Results\nSome **bold** text")),
                ],
            ),
            block([("id", s("files")), ("kind", s("list")), ("items", rows)]),
            block([("id", s("ask")), ("kind", s("input"))]),
            block(
                [
                    ("id", s("act")),
                    ("kind", s("buttons")),
                    ("items", json_array([s("Run"), s("Stop")])),
                ],
            ),
            block(
                [
                    ("id", s("busy")),
                    ("kind", s("progress")),
                    ("text", s("working")),
                    ("value", json_int(50)),
                ],
            ),
            block([("id", s("odd")), ("kind", s("sparkles"))]),
        ],
    )
    return obj(
        [
            ("id", s("p1")),
            ("title", s("Fake")),
            ("dock", s(dock if dock != "" else "right")),
            ("blocks", blocks),
        ],
    )
}

fun contributions() -> JsonValue {
    let cmds: list[JsonValue] = []
    for (n, t) in [
        ("fake.hello", "Say hello"),
        ("fake.edit", "Insert X"),
        ("fake.count", "Count chars"),
        ("fake.die", "Exit"),
        ("fake.panel", "Show a panel"),
        ("fake.pick", "Pick one"),
        ("fake.prompt", "Ask for text"),
        ("fake.marks", "Mark row 0"),
        ("fake.close", "Close the panel"),
        ("fake.touch", "Change the file on disk"),
        ("fake.sel", "Echo the selection"),
        ("fake.theme", "Define and pick a theme"),
    ] {
        cmds.push(obj([("name", s(n)), ("title", s(t))]))
    }
    let binds = [obj([("mode", s("normal")), ("keys", s("g h")), ("command", s("fake.hello"))])]
    return obj(
        [("name", s("fake")), ("commands", json_array(cmds)), ("bindings", json_array(binds))],
    )
}

class State {
    next_id: int = 1000
    // request id -> (purpose, id of the dusk request to answer, or -1)
    pending: dict[int, (str, int)] = {}
    record: bool = false
    seen: list[str] = []
}

fun ask(st: State, method: str, params: JsonValue, purpose: str, answer: int) {
    let id = st.next_id
    st.next_id += 1
    st.pending.set(id, (purpose, answer))
    send([("id", json_int(id)), ("method", s(method)), ("params", params)])
}

fun count_chars(text: str) -> int {
    var n = 0
    for c in text.chars() {
        if c != "\n" {
            n += 1
        }
    }
    return n
}

fun handle(st: State, line: str) -> bool {
    let v = match parse(line) {
        case Ok(x) { x }
        case Err(e) {
            return true
        }
    }
    let method = str_of(v, "method")
    let id = int_of(v, "id")
    let params = v.get("params").unwrap_or(JsonValue.Null)
    if st.record and method != "" and id < 0 {
        st.seen.push(method)
        notify("status/set", obj([("id", s("seen")), ("text", s(",".join(st.seen)))]))
    }
    if method == "" {
        match st.pending.get(id) {
            case Some(p) {
                let (purpose, answer) = p
                let _ = st.pending.remove(id)
                let res = v.get("result").unwrap_or(JsonValue.Null)
                if purpose == "pick" {
                    notify("ui/message", obj([("text", s("picked ${str_of(res, "label")}"))]))
                }
                if purpose == "prompt" {
                    let cancelled = match res.get("cancelled") {
                        case Some(c) { c.as_bool().unwrap_or(false) }
                        case None { false }
                    }
                    let said = "cancelled" if cancelled else "typed ${str_of(res, "text")}"
                    notify("ui/message", obj([("text", s(said))]))
                }
                if purpose == "themes" {
                    var n = 0
                    match res.get("themes") {
                        case Some(t) {
                            match t {
                                case Array(items) {
                                    n = len(items)
                                }
                                case _ {}
                            }
                        }
                        case None {}
                    }
                    notify("ui/message", obj([("text", s("themes ${n} current ${str_of(res, "current")}"))]))
                }
                if purpose == "count" {
                    notify(
                        "status/set",
                        obj([("id", s("chars")), ("text", s("chars: ${count_chars(str_of(res, "text"))}"))]),
                    )
                }
                if answer >= 0 {
                    reply(answer, obj([]))
                }
            }
            case None {}
        }
        return true
    }
    if method == "initialize" {
        reply(id, contributions())
    } else if method == "shutdown" {
        reply(id, obj([]))
        return false
    } else if method == "ui/event" {
        let value = match params.get("value") {
            case Some(v) { stringify(v) }
            case None { "" }
        }
        let text = "event ${str_of(params, "panel")} ${str_of(params, "block")} ${str_of(params, "kind")} ${value}"
        notify("ui/message", obj([("text", s(text))]))
    } else if method == "buffer/opened" or method == "buffer/changed" {
        ask(st, "buffer/text", obj([("path", s(str_of(params, "path")))]), "count", 0 - 1)
    } else if method == "command/run" {
        let cmd = str_of(params, "command")
        if cmd == "fake.hello" {
            notify("ui/message", obj([("text", s("hello from fake"))]))
            notify("status/set", obj([("id", s("fake")), ("text", s("said hello"))]))
            reply(id, obj([]))
        } else if cmd == "fake.edit" {
            let at = json_array([json_int(0), json_int(0)])
            let edit = obj([("start", at), ("end", at), ("text", s("X"))])
            let p = obj(
                [
                    ("path", s(str_of(params, "path"))),
                    ("version", json_int(int_of(params, "version"))),
                    ("edits", json_array([edit])),
                ],
            )
            ask(st, "buffer/edit", p, "edit", id)
        } else if cmd == "fake.panel" {
            notify("ui/panel", panel(str_of(params, "dock")))
            reply(id, obj([]))
        } else if cmd == "fake.close" {
            notify("ui/close", obj([("id", s("p1"))]))
            reply(id, obj([]))
        } else if cmd == "fake.pick" {
            let items = json_array([s("a"), obj([("label", s("b")), ("detail", s("second"))]), s("c")])
            ask(st, "ui/pick", obj([("title", s("Pick")), ("items", items)]), "pick", id)
        } else if cmd == "fake.prompt" {
            ask(st, "ui/prompt", obj([("title", s("Name")), ("text", s("x"))]), "prompt", id)
        } else if cmd == "fake.marks" {
            let m = obj(
                [
                    ("row", json_int(0)),
                    ("severity", s("error")),
                    ("message", s("bad line")),
                    ("sign", s("E")),
                ],
            )
            let far = obj([("row", json_int(999)), ("severity", s("warning")), ("message", s("far"))])
            notify("marks/set", obj([("path", s(str_of(params, "path"))), ("marks", json_array([m, far]))]))
            reply(id, obj([]))
        } else if cmd == "fake.sel" {
            notify("ui/message", obj([("text", s("sel ${str_of(params, "selection")}"))]))
            reply(id, obj([]))
        } else if cmd == "fake.touch" {
            let path = str_of(params, "path")
            let _ = write(path, "changed on disk\n")
            notify("files/changed", obj([("paths", json_array([s(path)]))]))
            reply(id, obj([]))
        } else if cmd == "fake.theme" {
            let colors = obj([("ui.bg", s("#101820")), ("keyword", s("#ff00aa"))])
            notify(
                "theme/define",
                obj(
                    [
                        ("name", s("fake-neon")),
                        ("base", s("nord")),
                        ("description", s("test")),
                        ("colors", colors),
                        ("glyphs", obj([("brand", s(" neon "))])),
                        ("labels", obj([("normal", s("GLOW"))])),
                    ],
                ),
            )
            notify("theme/define", obj([("name", s("broken")), ("colors", obj([("ui.bg", s("pink"))]))]))
            notify("theme/set", obj([("name", s("fake-neon"))]))
            ask(st, "theme/list", obj([]), "themes", id)
        } else if cmd == "fake.die" {
            exit(4)
        } else if cmd == "fake.count" {
            ask(st, "buffer/text", obj([("path", s(str_of(params, "path")))]), "count", id)
        } else {
            send(
                [
                    ("id", json_int(id)),
                    ("error", obj([("code", json_int(0 - 32601)), ("message", s("no command ${cmd}"))])),
                ],
            )
        }
    }
    return true
}

fun main() {
    let a = args()
    let mode = a[1] if len(a) > 1 else "echo"
    let st = State(record: mode == "record")
    var started = false
    while true {
        let line = read_line()
        if line == "" {
            return
        }
        if mode == "silent" {
            continue
        }
        if not started {
            started = true
            let keep = handle(st, line)
            if mode == "crash" {
                exit(3)
            }
            if mode == "flood" {
                for i in range(200000) {
                    notify("ui/message", obj([("text", s("flood ${i}"))]))
                }
            }
            if mode == "deaf" or mode == "bigline" {
                if mode == "bigline" {
                    print("x" * 9000000 + "\n")
                }
                while true {
                    sleep_millis(1000)
                }
            }
            if mode == "garbage" {
                print("this is not json\n")
            }
            if not keep {
                return
            }
            continue
        }
        if not handle(st, line) {
            return
        }
    }
}
